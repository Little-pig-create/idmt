# docker compose 用这个文件；复制成 deploy/.env 后按环境填写
# 生产：
#   SITE_ADDR=dmi.example.edu.cn
#   ADMIN_ADDR=admin.dmi.example.edu.cn
# 本地试跑（不配 DNS 时走明文 HTTP）：
#   SITE_ADDR=http://:8443
#   ADMIN_ADDR=http://:8444

# ---- 地址与 TLS ----
# 不带 http:// 前缀时 Caddy 自动申请 Let's Encrypt 证书
SITE_ADDR=dmi.example.edu.cn
ADMIN_ADDR=admin.dmi.example.edu.cn

# ---- 后台鉴权（唯一一道门）----
# 账号口令**不在这里**，在 deploy/site/admin.users（一行 `用户名 bcrypt哈希`，不入库）。
# 生成：docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '口令'
# 为什么不用环境变量传：docker compose 会解析值里的 `$`，
# bcrypt 的 `$2y$12$xxxx` 会被当成变量替换掉（实测哈希被吞，怎么输口令都是 401）。

# ---- 主机路径 ----
# DMI_ROOT 下应有 repo/ releases/ current(软链)
DMI_ROOT=/srv/dmi
DMI_REPO=/srv/dmi/repo
DMI_IMAGE=dmi/admin:node22

# ---- 后台界面权限（不是鉴权！只是编辑/只读的开关）----
ADMIN_ROLE=admin
