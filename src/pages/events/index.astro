---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/site/PageHero.astro';
import { u } from '../../lib/paths';

const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());
const typeLabel: Record<string, string> = { conference: '会议', seminar: '研讨会', lecture: '讲座', workshop: '工作坊' };
const now = Date.now();
const upcoming = events.filter((e) => e.data.startDate.getTime() >= now);
const past = events.filter((e) => e.data.startDate.getTime() < now);
const list = upcoming.length ? upcoming : events;
---

<BaseLayout title="学术活动" description="IDMT 学术会议、研讨会、讲座与工作坊安排。" transparentHeader>
  <PageHero
    eyebrow="EVENTS / 学术活动"
    title="把问题拿到桌面上讨论"
    description="论坛、研讨会与工作坊向高校师生与产业伙伴开放。我们更关心问题是否真实，而不是场面是否热闹。"
    crumbs={[{ label: '学术活动' }]}
    size="compact"
  />

  <section class="section bg-canvas">
    <div class="container-page">
      <div class="flex items-center justify-between">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">UPCOMING / 即将举行</p>
        <p class="text-[12px] text-ink-tertiary">共 {list.length} 场</p>
      </div>

      <ul class="mt-6 divide-y divide-line rounded-2xl border border-line bg-surface">
        {list.map((e) => (
          <li>
            <a href={u(`/events/${e.id}`)} class="group grid gap-5 p-6 sm:grid-cols-[100px_1fr_auto] sm:items-center">
              <div class="flex items-baseline gap-2 sm:flex-col sm:items-start sm:gap-1">
                <span class="font-display text-[2rem] font-bold leading-none text-ink">{String(e.data.startDate.getDate()).padStart(2, '0')}</span>
                <span class="font-mono text-[10.5px] tracking-[0.12em] text-ink-tertiary">{e.data.startDate.getFullYear()}.{String(e.data.startDate.getMonth() + 1).padStart(2, '0')}</span>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-brand-soft px-2.5 py-0.5 text-[10.5px] font-medium text-brand-ink">{typeLabel[e.data.type]}</span>
                  <span class="text-[11.5px] text-ink-tertiary">{e.data.location}</span>
                </div>
                <h2 class="mt-2 font-display text-[1.15rem] font-semibold text-ink group-hover:text-brand">{e.data.title}</h2>
                <p class="mt-1.5 text-[13px] leading-relaxed text-ink-secondary">{e.data.summary}</p>
              </div>
              <span class="hidden text-[12.5px] font-medium text-brand sm:block">详情 →</span>
            </a>
          </li>
        ))}
      </ul>

      {past.length > 0 && (
        <div class="mt-14">
          <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">PAST / 往期</p>
          <ul class="mt-4 space-y-3">
            {past.map((e) => (
              <li class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3 text-[13px]">
                <span class="text-ink">{e.data.title}</span>
                <span class="font-mono text-[11px] text-ink-tertiary">{e.data.startDate.getFullYear()}.{String(e.data.startDate.getMonth() + 1).padStart(2, '0')}.{String(e.data.startDate.getDate()).padStart(2, '0')}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
