---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import { base, baseSlash } from '../lib/paths';
---

<BaseLayout title="全站搜索" description="搜索 IDMT 的研究方向、产品、新闻与通知。" transparentHeader>
  <PageHero
    eyebrow="SEARCH / 全站搜索"
    title="搜索研究院"
    description="按关键词检索研究方向、产品方案、新闻、活动与通知。"
    crumbs={[{ label: '全站搜索' }]}
    size="compact"
  />

  <section class="section bg-canvas">
    <div class="container-page max-w-3xl">
      <label class="block">
        <span class="sr-only">搜索关键词</span>
        <div class="flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 shadow-[var(--shadow-xs)] focus-within:border-brand">
          <svg viewBox="0 0 20 20" class="size-4 text-ink-tertiary" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5" />
            <path d="m13.5 13.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <input
            id="q"
            type="search"
            autocomplete="off"
            placeholder="输入关键词，例如「液冷」「固态储氢」「低空」"
            class="w-full bg-transparent text-[15px] text-ink outline-none placeholder:text-ink-tertiary"
          />
        </div>
      </label>

      <p id="meta" class="mt-4 text-[12px] text-ink-tertiary">输入关键词开始检索。</p>
      <ul id="results" class="mt-6 space-y-3"></ul>
    </div>
  </section>

  <script define:vars={{ indexUrl: baseSlash + 'search-index.json', base }}>
    const input = document.getElementById('q');
    const meta = document.getElementById('meta');
    const list = document.getElementById('results');
    let index = [];

    const render = (items, query) => {
      list.innerHTML = '';
      if (!query) {
        meta.textContent = '输入关键词开始检索。';
        return;
      }
      meta.textContent = items.length ? `找到 ${items.length} 条结果` : `没有找到与「${query}」相关的内容。`;
      for (const item of items.slice(0, 30)) {
        const li = document.createElement('li');
        li.className = 'rounded-xl border border-line bg-surface p-5';
        const a = document.createElement('a');
        a.href = base + item.href;
        a.className = 'group block';
        const type = document.createElement('span');
        type.className = 'font-mono text-[10px] tracking-[0.14em] text-brand';
        type.textContent = item.type;
        const h = document.createElement('h2');
        h.className = 'mt-1.5 font-display text-[1.1rem] font-semibold text-ink group-hover:text-brand';
        h.textContent = item.title;
        const p = document.createElement('p');
        p.className = 'mt-1.5 text-[13px] leading-relaxed text-ink-secondary';
        p.textContent = item.description;
        a.append(type, h, p);
        li.append(a);
        list.append(li);
      }
    };

    fetch(indexUrl)
      .then((r) => r.json())
      .then((data) => {
        index = data;
        const params = new URLSearchParams(location.search);
        const initial = params.get('q') ?? '';
        if (initial) {
          input.value = initial;
          run(initial);
        }
      })
      .catch(() => {
        meta.textContent = '索引加载失败，请稍后再试。';
      });

    function run(query) {
      const q = query.trim().toLowerCase();
      if (!q) return render([], '');
      const items = index.filter((item) =>
        `${item.title} ${item.description} ${item.text}`.toLowerCase().includes(q),
      );
      render(items, query.trim());
    }

    input.addEventListener('input', (event) => run(event.target.value));
  </script>
</BaseLayout>
