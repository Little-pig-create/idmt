---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import AsideBox from '../components/ui/AsideBox.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { site } from '../data/site';

const datasets = [
  {
    name: '基层治理数字化案例库',
    desc: '四个观察点的过程追踪记录与访谈材料整理稿，含编码手册。',
    license: 'CC BY-NC 4.0',
    citation: '陈立, 何雨桐. 基层治理数字化案例库（2024-2027）[DS]. 数字管理研究院.',
    access: '需提交研究用途说明后获取',
  },
  {
    name: '公共数据授权运营试点指标集',
    desc: '试点地区公共数据授权运营的公开运行指标，按季度更新。',
    license: 'CC BY 4.0',
    citation: '林思远. 公共数据授权运营试点指标集（2026）[DS]. 数字管理研究院.',
    access: '开放下载',
  },
];

const licenses = [...new Set(datasets.map((d) => d.license))];
---

<BaseLayout
  title="数据集与资源"
  description="数字管理研究院开放的研究数据集、工具与引用说明。"
>
  <PageHero
    eyebrow="Resources"
    title="数据集与资源"
    description="研究院在研究中形成的数据集与工具，在合规前提下向研究同行开放。"
    crumbs={[{ label: '成果与动态', href: '/publications' }, { label: '数据集与资源' }]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_320px] lg:gap-16">
        <div>
          <SectionHeading eyebrow="Datasets" title="开放数据集" />

          <div class="space-y-6">
            {
              datasets.map((ds) => (
                <article class="card p-6 lg:p-8">
                  <h3 class="text-h3">{ds.name}</h3>
                  <p class="mt-3 max-w-3xl text-ui leading-relaxed text-ink-secondary">{ds.desc}</p>

                  <dl class="mt-5 grid gap-4 border-t border-line pt-5 sm:grid-cols-3">
                    <div>
                      <dt class="eyebrow mb-1.5">许可协议</dt>
                      <dd class="text-ui text-ink">{ds.license}</dd>
                    </div>
                    <div>
                      <dt class="eyebrow mb-1.5">获取方式</dt>
                      <dd class="text-ui text-ink">{ds.access}</dd>
                    </div>
                    <div>
                      <dt class="eyebrow mb-1.5">引用格式</dt>
                      <dd class="text-meta leading-relaxed text-ink-secondary">{ds.citation}</dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>

          <div class="mt-10">
            <EmptyState
              title="需要其他研究材料？"
              description="部分中间成果与编码手册未在此列出，可通过邮件说明研究用途后索取。"
              actionHref="/contact"
              actionLabel="联系我们"
            />
          </div>
        </div>

        <aside class="lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
          <AsideBox title="使用说明">
            <p class="text-ui leading-relaxed text-ink-secondary">
              开放数据集均已完成去标识化处理。使用前请阅读各数据集的许可协议，并在发表成果时按给出的引用格式标注来源。
            </p>
            <p class="mt-3 text-ui leading-relaxed text-ink-secondary">
              涉及个人信息的原始材料不对外开放。
            </p>
          </AsideBox>

          <AsideBox title="许可协议">
            <ul class="space-y-2">
              {
                licenses.map((l) => (
                  <li class="flex items-baseline justify-between gap-3 text-ui">
                    <span class="text-ink-secondary">{l}</span>
                    <span class="numeric text-meta text-ink-tertiary">
                      {datasets.filter((d) => d.license === l).length} 项
                    </span>
                  </li>
                ))
              }
            </ul>
          </AsideBox>

          <AsideBox title="数据咨询">
            <p class="text-ui leading-relaxed text-ink-secondary">
              数据获取与研究用途说明请通过邮件联系院务办公室。
            </p>
            <p class="mt-3">
              <a href={`mailto:${site.email}`} class="link break-all">{site.email}</a>
            </p>
          </AsideBox>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
