---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import SectionHead from '../components/site/SectionHead.astro';
import { site } from '../data/site';
import { u } from '../lib/paths';

const tracks = [
  {
    title: '联合培养研究生',
    en: 'GRADUATE',
    desc: '与高校联合招收硕士、博士研究生，课题来自在研项目，双导师制。',
    items: ['智能算力与数字基础设施', '人工智能与无人系统', '机器人与具身智能', '增材制造与工业软件'],
  },
  {
    title: '博士后与专职研究员',
    en: 'RESEARCH FELLOW',
    desc: '面向已获得博士学位的青年学者，提供独立课题与工程团队支持。',
    items: ['固态储氢材料与系统', '低空飞行器与运行监管', '行业大模型与知识工程', '工业软件与数字孪生'],
  },
  {
    title: '工程师与产品岗位',
    en: 'ENGINEER',
    desc: '硬件、嵌入式、算法、结构与工业设计岗位长期开放。',
    items: ['高速数字硬件与 SI/PI', '运动控制与嵌入式软件', '感知算法与 SLAM', '结构与热设计'],
  },
  {
    title: '产业合作与联合实验室',
    en: 'PARTNERSHIP',
    desc: '与企业共建联合实验室、共担课题、共享设备与数据。',
    items: ['场景共研与课题共建', '设备与实验室共享', '课程共建与订单培养', '成果转化与孵化'],
  },
];

const steps = [
  { n: '01', t: '提交意向', d: '通过联系表单或邮箱提交简历、研究陈述或合作设想。' },
  { n: '02', t: '方向匹配', d: '五个工作日内，由对应研究中心负责人评估方向契合度。' },
  { n: '03', t: '交流与评审', d: '研究岗安排学术报告，工程岗安排技术面谈。' },
  { n: '04', t: '发放邀请', d: '通过后发放录用或合作邀请，明确课题、导师与资源。' },
];
---

<BaseLayout title="加入我们" description="IDMT 联合培养研究生、博士后、工程师与产业合作岗位长期开放。" transparentHeader image="/images/vr-education.jpg">
  <PageHero
    eyebrow="CAREERS / 加入我们"
    title="和一群把问题做完的人共事"
    description="我们看重的是：能不能把一个问题从提出做到跑通。学历与头衔是参考，作品与判断力是依据。"
    crumbs={[{ label: '加入我们' }]}
    image={u('/images/vr-education.webp')}
  />

  <section class="section bg-canvas">
    <div class="container-page">
      <SectionHead eyebrow="TRACKS / 加入方式" title="四条通道，同一套标准" description="不论来自学界还是产业，我们只用同一套标准评估：问题是否真实、方法是否可靠、结果是否可复现。" />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {tracks.map((track) => (
          <div class="rounded-2xl border border-line bg-surface p-7">
            <p class="font-mono text-[9.5px] tracking-[0.2em] text-brand">{track.en}</p>
            <h3 class="mt-3 font-display text-[1.35rem] font-bold text-ink">{track.title}</h3>
            <p class="mt-2 text-[13.5px] leading-relaxed text-ink-secondary">{track.desc}</p>
            <ul class="mt-5 grid gap-2 sm:grid-cols-2">
              {track.items.map((item) => (
                <li class="flex items-center gap-2 text-[12.5px] text-ink-secondary"><span class="size-1 rounded-full bg-brand-2"></span>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-t border-line bg-surface">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="eyebrow">PROCESS / 流程</p>
        <h2 class="mt-4 font-display text-h2 font-bold tracking-[-0.02em] text-ink">四步，通常两周内走完</h2>
        <p class="mt-4 max-w-sm text-[14px] leading-relaxed text-ink-secondary">我们尽量让流程短一些。拖长流程对双方都是成本。</p>
        <a href={u("/contact")} class="mt-7 inline-flex h-11 items-center rounded-lg bg-ink px-5 text-[13.5px] font-semibold text-white">提交意向</a>
      </div>

      <ol class="relative space-y-0 border-l border-line pl-8">
        {steps.map((s) => (
          <li class="relative pb-9 last:pb-0">
            <span class="absolute -left-[41px] grid size-5 place-items-center rounded-full border border-line bg-surface font-mono text-[9px] text-brand">{s.n}</span>
            <p class="font-display text-[1.05rem] font-semibold text-ink">{s.t}</p>
            <p class="mt-1.5 text-[13px] leading-relaxed text-ink-secondary">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="night">
    <div class="container-page section-tight text-center">
      <p class="font-mono text-[10px] tracking-[0.22em] text-white/40">QUESTIONS</p>
      <p class="mx-auto mt-4 max-w-xl text-[15px] leading-relaxed text-white/70">
        不确定自己适合哪条通道？把简历和一段研究兴趣发到 <a href={`mailto:${site.email}`} class="text-[var(--color-brand-2)] underline underline-offset-4">{site.email}</a>，我们会转给对应方向。
      </p>
    </div>
  </section>
</BaseLayout>
