---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { site } from '../data/site';
import { u } from '../lib/paths';

const people = (await getCollection('people', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const requirements = [
  '具备管理学、经济学、公共管理、统计学或计算机相关背景；',
  '对实证研究或建模分析有明确兴趣，愿意花时间处理数据与文献；',
  '提交个人陈述、本科成绩单与两封推荐信。',
];

const positions = [
  {
    title: '研究助理（在校生）',
    duty: '协助数据整理、文献梳理与访谈记录整理。',
    require: '每周可投入 8 小时以上，连续参与一个学期。',
  },
  {
    title: '博士后研究员',
    duty: '独立承担方向内课题，参与项目申报与论文写作。',
    require: '已获博士学位，有公共管理或管理科学相关发表记录。',
  },
];
---

<BaseLayout
  title="招生招聘"
  description="数字管理研究院研究生招生、研究助理与博士后招聘信息。"
>
  <PageHero
    eyebrow="Join us"
    title="招生与招聘"
    description="研究院每年招收硕士研究生，并提供面向在校生的研究助理岗位与博士后职位。"
    crumbs={[{ label: '加入我们' }]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
        <div class="container-prose prose-academic lg:mx-0">
          <h2 id="admission">研究生招生</h2>
          <p>
            研究院四个研究方向均招收硕士研究生。我们看重对问题的好奇心，胜过对工具的熟练度。
            你不需要在入学前就会写代码，但需要愿意学。
          </p>

          <h3>申请要求</h3>
          <ul>
            {requirements.map((r) => <li>{r}</li>)}
          </ul>

          <h3>时间安排</h3>
          <p>
            材料提交截止日期为 <strong>9 月 30 日</strong>，面试安排在 10 月中旬。
            有意申请者可先通过邮件联系意向导师，说明研究兴趣。
          </p>

          <h2 id="positions">招聘岗位</h2>
          {positions.map((p) => (
            <div>
              <h3>{p.title}</h3>
              <p>{p.duty}</p>
              <p><strong>要求：</strong>{p.require}</p>
            </div>
          ))}

          <h2 id="how">如何申请</h2>
          <p>
            请将个人简历与研究兴趣说明发送至 <a href={`mailto:${site.email}`}>{site.email}</a>，
            邮件标题请注明「申请方向 + 姓名」。
          </p>
        </div>

        <aside class="space-y-8 lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
          <div class="border-t border-line pt-5">
            <p class="eyebrow mb-3">招生方向</p>
            <ul class="space-y-3">
              {
                people.length > 0 &&
                  [...new Set(people.flatMap((p) => p.data.researchAreas))].map((area) => (
                    <li class="text-ui text-ink-secondary">{area}</li>
                  ))
              }
            </ul>
          </div>

          <div class="border-t border-line pt-5">
            <p class="eyebrow mb-3">联系导师</p>
            <ul class="space-y-3">
              {
                people.map((person) => (
                  <li>
                    <a href={u(`/people/${person.id}`)} class="link-title block text-ui">
                      {person.data.name}
                    </a>
                    <p class="mt-0.5 text-meta text-ink-tertiary">{person.data.title}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
