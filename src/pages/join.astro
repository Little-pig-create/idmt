---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { researchAreas, site } from '../data/site';
import { u } from '../lib/paths';

const people = (await getCollection('people', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="加入我们"
  description={`${site.name}的人才培养方向与学生科研实践机会。`}
>
  <PageHero
    eyebrow="Join us"
    title="加入我们"
    description="研究院依托浙江树人学院开展科研与人才培养，为在校学生参与科研实践创造条件。"
    crumbs={[{ label: '加入我们' }]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
        <div class="container-prose prose-academic lg:mx-0">
          <h2 id="practice">学生科研实践</h2>
          <p>
            研究院坚持科教结合，把科研育人作为日常工作的一部分：学生在在读期间可以参与方向内的
            数据整理、文献梳理、平台搭建与实验组织等具体工作，接触从问题提出到成果成型的完整过程。
          </p>
          <p>
            有参与意向的在校生请联系所在学院的学业导师，或经由依托学院的教务办公室转达。
            研究院不单设报名通道，也不通过邮件收取申请材料。
          </p>

          <h2 id="admission">研究生招生</h2>
          <p>
            硕士与博士研究生的招生资格、专业目录、报名条件与时间安排，
            以<strong>浙江树人学院研究生院及各招生学院发布的当年招生简章</strong>为准。
            研究院本身不独立发布招生章程，本页也不代替官方通知。
          </p>
          <p>
            本站尚未收录经核实的招生条目。相关公告一旦确定，会先发布于
            <a href={u('/notices')}>通知公告</a>，再同步到本页。
          </p>

          <h2 id="positions">岗位招聘</h2>
          <p>
            研究院目前<strong>没有公开发布的招聘公告</strong>（含研究岗、博士后与行政岗）。
            本页此前列出的岗位与申请要求属于建站示例内容，已随示例数据一并撤下。
          </p>
          <p>
            如有合作、访学或应聘意向，请通过
            <a href={u('/contact')}>联系我们</a>页面所列的官方渠道与依托学院接洽。
          </p>
        </div>

        <aside class="space-y-8 lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
          <div class="border-t border-line pt-5">
            <p class="eyebrow mb-3">可参与的研究方向</p>
            <ul class="space-y-3">
              {
                researchAreas.map((area) => (
                  <li class="text-ui text-ink-secondary">{area}</li>
                ))
              }
            </ul>
          </div>

          <div class="border-t border-line pt-5">
            <p class="eyebrow mb-3">管理团队</p>
            <ul class="space-y-3">
              {
                people.map((person) => (
                  <li>
                    <a href={u(`/people/${person.id}`)} class="link-title block text-ui">
                      {person.data.name}
                    </a>
                    <p class="mt-0.5 text-meta text-ink-tertiary">{person.data.title}</p>
                  </li>
                ))
              }
            </ul>
            <p class="mt-3 text-meta text-ink-tertiary">
              以上为研究院公开报道的管理职务，不构成导师资格或招生方向的承诺。
            </p>
          </div>

          <div class="border-t border-line pt-5">
            <p class="eyebrow mb-3">相关入口</p>
            <ul class="space-y-2 text-ui">
              <li><a href={u('/notices')} class="link">通知公告</a></li>
              <li><a href={u('/people')} class="link">研究团队</a></li>
              <li><a href={u('/contact')} class="link">联系我们</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
