---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import DetailFigure from '../../components/ui/DetailFigure.astro';
import { publicationTypeLabels, site } from '../../data/site';
import { toBibtex } from '../../lib/bibtex';
import { toGbt7714, formatVenue } from '../../lib/citation';
import { u } from '../../lib/paths';

export async function getStaticPaths() {
  const publications = await getCollection('publications', ({ data }) => !data.draft);
  return publications.map((p) => ({
    params: { slug: p.id },
    props: { item: p },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const data = item.data;

const typeLabel = publicationTypeLabels[data.type] ?? data.type;
const doiHref = data.doi ? (data.doi.startsWith('http') ? data.doi : `https://doi.org/${data.doi}`) : undefined;
const bibtex = toBibtex(data);

/** 载体名按语言分流：中文用《》，拉丁用斜体（见 lib/citation.ts） */
const venueText = formatVenue(data.venue);

/**
 * 摘要正文。`item.body` 在 Astro 5+ 是构建期已读入的字符串，
 * 同时喂给 citation_abstract 元数据与页面上的摘要块，避免两处不一致。
 */
const abstractText = item.body?.trim() ?? '';

/** GB/T 7714 国标引用条目（中文期刊投稿与学位论文的强制格式） */
const gbt = toGbt7714({
  title: data.title,
  authors: data.authors,
  venue: data.venue,
  year: data.year,
  type: data.type,
  volume: data.volume,
  issue: data.issue,
  pages: data.pages,
  doi: data.doi,
  pdf: data.pdf,
});

/** 作者 → 成员主页：按姓名匹配 people，机构外作者保持纯文本 */
const allPeople = await getCollection('people', ({ data }) => !data.draft);
const peopleByName = new Map(allPeople.map((p) => [p.data.name, p.id]));

// 同作者相关：同一作者的其他成果（在作者详情页里也已有逻辑；这里按全团队的前 N 篇补充）
const allPubs = await getCollection('publications', ({ data }) => !data.draft);
const related = allPubs
  .filter((p) => p.id !== item.id && p.data.authors.some((a) => data.authors.includes(a)))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 5)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    authors: p.data.authors,
    venue: p.data.venue,
    year: p.data.year,
    type: p.data.type,
  }));
---

<BaseLayout
  title={data.title}
  description={`${data.authors.join('、')}。${data.venue}，${data.year}。${typeLabel}。`}
  type="article"
  citation={{
    title: data.title,
    authors: data.authors,
    venue: data.venue,
    year: data.year,
    type: data.type,
    volume: data.volume,
    issue: data.issue,
    pages: data.pages,
    doi: data.doi,
    pdf: data.pdf,
    abstract: abstractText || undefined,
  }}
>
  <JsonLd
    data={{
      '@type': 'ScholarlyArticle',
      headline: data.title,
      name: data.title,
      datePublished: `${data.year}`,
      author: data.authors.map((a) => ({ '@type': 'Person', name: a })),
      isPartOf: { '@type': 'Periodical', name: data.venue },
      ...(data.doi ? { identifier: data.doi.startsWith('http') ? data.doi : `https://doi.org/${data.doi}` } : {}),
      keywords: data.tags.join(', '),
      url: new URL(u(`/publications/${item.id}`), site.url).toString(),
      inLanguage: 'zh-CN',
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    }}
  />
  <PageHero
    eyebrow={typeLabel}
    title={data.title}
    crumbs={[
      { label: '成果与动态', href: '/publications' },
      { label: '学术成果', href: '/publications' },
      { label: data.title },
    ]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_320px] lg:gap-16">
        <article class="container-prose prose-academic">
          <header class="not-prose mb-6 border-b border-line pb-6">
            <p class="text-ui text-ink-secondary">
              {data.authors.map((author, i) => {
                const personId = peopleByName.get(author);
                return (
                  <>
                    {i > 0 && <span class="text-ink-tertiary">, </span>}
                    {personId ? (
                      <a href={u(`/people/${personId}`)} class="text-ink link-title">
                        {author}
                      </a>
                    ) : (
                      <span class="text-ink">{author}</span>
                    )}
                  </>
                );
              })}
            </p>
            <p class="mt-2 text-ui text-ink-secondary">
              <cite class:list={[venueText.italic ? 'italic' : 'not-italic']}>{venueText.text}</cite>
              <span class="numeric">, {data.year}</span>
              {(data.volume || data.issue || data.pages) && (
                <span class="numeric">
                  , {[
                    data.volume && data.issue ? `${data.volume}(${data.issue})` : (data.volume ?? (data.issue ? `(${data.issue})` : '')),
                    data.pages,
                  ].filter(Boolean).join(': ')}
                </span>
              )}
              <span class="tag tag-quiet ml-3">{typeLabel}</span>
              {data.featured && <span class="tag ml-2">精选</span>}
            </p>
          </header>

          <DetailFigure
            cover={data.cover}
            coverAlt={data.coverAlt}
            seed={item.id}
            caption={data.coverAlt}
            loading="eager"
            class="mb-6"
          />

          {/*
            摘要与关键词按学术体例标注：摘要是一个有标识的块，关键词独立成行用分号分隔。
            此前它们是裸正文 + header 里的散落 chips，读者看不出这是摘要。
          */}
          {abstractText ? (
            <section class="abstract-block" aria-labelledby="abstract-heading">
              <h2 id="abstract-heading" class="abstract-heading">摘要</h2>
              <div class="abstract-body">
                <Content />
              </div>
            </section>
          ) : (
            <p class="text-ink-tertiary">（暂无摘要）</p>
          )}

          {data.tags.length > 0 && (
            <p class="keywords-line">
              <span class="keywords-label">关键词：</span>
              {data.tags.join('；')}
            </p>
          )}
        </article>

        <aside class="space-y-8 lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
          {/* 引用出口 */}
          <div class="rounded-md border border-line bg-surface p-5" data-cite-card>
            <p class="eyebrow mb-3">引用此成果</p>
            <div class="flex flex-wrap gap-2">
              {doiHref && (
                <a href={doiHref} rel="noopener" class="btn btn-secondary numeric">DOI</a>
              )}
              {data.pdf && (
                <a href={data.pdf} class="btn btn-secondary numeric">PDF</a>
              )}
            </div>

            {/*
              两种引用格式：GB/T 7714 是中文期刊投稿与学位论文的强制格式，
              BibTeX 服务 LaTeX 用户。只给 BibTeX 等于只覆盖了一半的使用场景。
            */}
            <details class="mt-4" open>
              <summary
                class="flex min-h-11 cursor-pointer list-none items-center text-meta text-ink-secondary select-none hover:text-accent"
              >
                GB/T 7714 引用条目
              </summary>
              <p
                class="citation-text mt-3 rounded-sm border border-line bg-surface-subtle p-3"
                data-cite-text
              >{gbt}</p>
              <button
                type="button"
                class="btn btn-secondary mt-3 numeric"
                data-copy-cite
                aria-label="复制 GB/T 7714 引用条目到剪贴板"
              >复制引用</button>
            </details>

            <details class="mt-3">
              <summary
                class="flex min-h-11 cursor-pointer list-none items-center text-meta text-ink-secondary select-none hover:text-accent"
              >BibTeX 引用条目</summary>
              <pre
                class="bibtex mt-3 overflow-x-auto rounded-sm border border-line bg-surface-subtle p-3 text-[0.75rem] leading-relaxed text-ink-secondary"
                data-cite-text>{bibtex}</pre>
              <button
                type="button"
                class="btn btn-secondary mt-3 numeric"
                data-copy-cite
                aria-label="复制 BibTeX 引用条目到剪贴板"
              >复制 BibTeX</button>
            </details>

            <p class="mt-2 text-meta text-ink-tertiary" data-copy-status aria-live="polite"></p>
          </div>

          {/* 相关成果 */}
          {related.length > 0 && (
            <div>
              <p class="eyebrow mb-3">同作者相关</p>
              <ul class="space-y-3">
                {related.map((r) => (
                  <li class="border-l-2 border-line pl-3">
                    <a href={u(`/publications/${r.id}`)} class="block">
                      <p class="text-ui font-medium text-ink hover:text-accent">{r.title}</p>
                      <p class="numeric mt-0.5 text-meta text-ink-tertiary">
                        {r.venue}, {r.year}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // 复制引用条目（GB/T 7714 与 BibTeX 共用同一套逻辑）：
  // 按钮从最近的 details 里取文本节点，状态行在整张卡片内查找（它不在 details 内部）。
  function initCiteCopy(root: Document | ShadowRoot = document) {
    root.querySelectorAll<HTMLElement>('[data-copy-cite]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const textEl = btn.closest('details')?.querySelector('[data-cite-text]') as HTMLElement | null;
        if (!textEl) return;
        const status = btn.closest('[data-cite-card]')?.querySelector('[data-copy-status]') as HTMLElement | null;
        try {
          await navigator.clipboard.writeText(textEl.textContent ?? '');
          if (status) status.textContent = '已复制到剪贴板';
        } catch {
          if (status) status.textContent = '复制失败，请手动选择并复制';
        }
        setTimeout(() => {
          if (status) status.textContent = '';
        }, 4000);
      });
    });
  }
  document.addEventListener('astro:page-load', () => initCiteCopy());
  initCiteCopy();
</script>