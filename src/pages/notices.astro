---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';

const notices = (await getCollection('notices', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.getTime() - a.data.date.getTime()
);
const categories = ['招生', '招聘', '科研', '会议', '其他'] as const;
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="通知公告" description="IDMT 招生、招聘、科研项目与会议通知。" transparentHeader>
  <PageHero
    eyebrow="NOTICES / 通知公告"
    title="通知与公告"
    description="招生、招聘、开放课题与会议信息。所有公告以本页为准。"
    crumbs={[{ label: '通知公告' }]}
    size="compact"
  />

  <section class="section bg-canvas">
    <div class="container-page grid gap-12 lg:grid-cols-[220px_1fr]">
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">CATEGORIES</p>
        <ul class="mt-4 space-y-1.5">
          {categories.map((c) => (
            <li class="flex items-center justify-between rounded-lg bg-surface px-3 py-2 text-[13px] text-ink-secondary">
              <span>{c}</span>
              <span class="font-mono text-[10.5px] text-ink-tertiary">{notices.filter((n) => n.data.category === c).length}</span>
            </li>
          ))}
        </ul>
      </aside>

      <div>
        <ul class="divide-y divide-line rounded-2xl border border-line bg-surface">
          {notices.map((n) => (
            <li class="flex flex-wrap items-start gap-4 p-6">
              <div class="flex w-24 shrink-0 flex-col gap-1">
                <span class="rounded bg-brand-soft px-2 py-0.5 text-center text-[10.5px] font-medium text-brand-ink">{n.data.category}</span>
                {n.data.pinned && <span class="text-center font-mono text-[9.5px] tracking-[0.1em] text-gold">置顶</span>}
              </div>
              <div class="min-w-0 flex-1">
                <h2 class="text-[15px] font-semibold leading-snug text-ink">{n.data.title}</h2>
                <div class="prose-idmt mt-2 max-w-none text-[13px]"><p class="text-ink-secondary">{n.data.summary ?? ''}</p></div>
              </div>
              <time class="font-mono text-[11px] text-ink-tertiary" datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
