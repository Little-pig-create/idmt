---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { site } from '../data/site';
import { u } from '../lib/paths';

const ZJSRU = 'https://www.zjsru.edu.cn/';
---

<BaseLayout
  title="联系我们"
  description={`${site.name}的办公地址与对外联系渠道。`}
>
  <PageHero
    eyebrow="Contact"
    title="联系我们"
    description="研究院依托浙江树人学院设立，对外事务经由学校与所在学院的公开渠道办理。"
    crumbs={[{ label: '加入我们', href: '/join' }, { label: '联系我们' }]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
        <div class="container-prose prose-academic lg:mx-0">
          <h2 id="address">办公地址</h2>
          <address class="not-prose not-italic">
            <p class="text-body leading-relaxed text-ink">{site.address}</p>
            {site.postcode && <p class="numeric mt-2 text-ui text-ink-secondary">邮编 {site.postcode}</p>}
          </address>
          <p>
            两个校区的具体楼宇与门牌号尚未在本站核定，来访前请先经学校办公室确认接待地点。
          </p>

          <h2 id="channels">联系渠道</h2>
          {
            site.email || site.phone ? (
              <p>
                {site.phone && <>电话：<a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /></>}
                {site.email && <>邮箱：<a href={`mailto:${site.email}`}>{site.email}</a></>}
              </p>
            ) : (
              <p>
                研究院尚未在本站公布独立的电话、邮箱与接待时间。院务、合作与媒体事务请通过
                <a href={ZJSRU} rel="noopener" target="_blank">浙江树人学院官网</a>所列的学校办公室、
                经济与管理学院渠道联系，说明事由后由学校转达。
              </p>
            )
          }
          <p>
            招生、招聘与公告类信息一律以学校正式发文为准，本站只收录已经公开报道或学校发布过的内容，
            具体见<a href={u('/notices')}>通知公告</a>与<a href={u('/join')}>加入我们</a>。
          </p>
        </div>

        <div>
          <ul class="space-y-4">
            <li class="card p-6">
              <h2 class="text-h3">院务与合作</h2>
              <p class="mt-2 text-ui text-ink-secondary">合作洽谈、来访预约、资料索取。</p>
              <p class="mt-4 border-t border-line pt-4 text-ui text-ink-secondary">
                经浙江树人学院经济与管理学院办公室转达。
              </p>
            </li>
            <li class="card p-6">
              <h2 class="text-h3">研究生招生</h2>
              <p class="mt-2 text-ui text-ink-secondary">专业目录、报名条件与时间安排。</p>
              <p class="mt-4 border-t border-line pt-4 text-ui text-ink-secondary">
                以学校研究生院当年招生简章为准，本站不代替官方通知。
              </p>
            </li>
            <li class="card p-6">
              <h2 class="text-h3">媒体与转载</h2>
              <p class="mt-2 text-ui text-ink-secondary">采访邀约、内容使用与转载。</p>
              <p class="mt-4 border-t border-line pt-4 text-ui text-ink-secondary">
                本站内容为建设版本，正式对外口径以研究院与学校发布为准。
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
