---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import ContactForm from '../components/site/ContactForm.tsx';
import { site } from '../data/site';
---

<BaseLayout title="联系我们" description="联系 IDMT：合作、招聘、媒体与来访。" transparentHeader>
  <PageHero
    eyebrow="CONTACT / 联系我们"
    title="告诉我们你正在解决的问题"
    description="合作、招聘、媒体采访或来访交流，都可以从这个表单开始。我们通常会在五个工作日内回复。"
    crumbs={[{ label: '联系我们' }]}
    size="compact"
  />

  <section class="section bg-canvas">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="space-y-4">
        {[
          { k: '地址', v: site.address, n: 'ADDRESS' },
          { k: '邮箱', v: site.email, n: 'EMAIL', href: `mailto:${site.email}` },
          { k: '电话', v: site.phone, n: 'PHONE', href: `tel:${site.phone.replace(/\s/g, '')}` },
          { k: '工作时间', v: '周一至周五 · 09:00–18:00', n: 'HOURS' },
        ].map((item) => (
          <div class="rounded-2xl border border-line bg-surface p-6">
            <p class="font-mono text-[9.5px] tracking-[0.2em] text-ink-tertiary">{item.n}</p>
            {item.href ? (
              <a href={item.href} class="mt-2 block text-[15px] font-medium text-ink hover:text-brand">{item.v}</a>
            ) : (
              <p class="mt-2 text-[15px] font-medium text-ink">{item.v}</p>
            )}
          </div>
        ))}
        <p class="px-1 text-[11.5px] leading-relaxed text-ink-tertiary">
          注：详细门牌地址与来访预约方式，以邮件确认为准。
        </p>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-7 lg:p-10">
        <h2 class="font-display text-[1.5rem] font-bold text-ink">提交需求</h2>
        <p class="mt-2 text-[13.5px] text-ink-secondary">填写后会在本地生成一封邮件，确认无误再发送。</p>
        <div class="mt-7">
          <ContactForm client:load email={site.email} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
