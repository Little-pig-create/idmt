---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import { site } from '../data/site';
import { u } from '../lib/paths';
---

<BaseLayout title="联系我们" description="联系 IDMT：合作、人才与媒体事宜。" transparentHeader>
  <PageHero
    eyebrow="CONTACT / 联系我们"
    title="联系研究院"
    description="合作、人才与媒体事宜，请通过研究院官方渠道联系。"
    crumbs={[{ label: '联系我们' }]}
    size="compact"
  />

  <section class="section bg-canvas">
    <div class="container-page grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div class="rounded-2xl border border-line bg-surface p-8 lg:p-10">
        <p class="font-mono text-[10px] tracking-[0.22em] text-brand">OFFICIAL CHANNELS</p>
        <h2 class="mt-3 font-display text-[1.6rem] font-bold text-ink">联系方式</h2>
        <p class="mt-4 text-[14.5px] leading-[1.9] text-ink-secondary">{site.contactNote}</p>
        <p class="mt-6 border-t border-line pt-5 text-[12px] leading-relaxed text-ink-tertiary">
          为避免误导，本站不展示未经研究院确认的邮箱、电话与地址。
        </p>
      </div>

      <div>
        <p class="eyebrow">WHAT WE TALK ABOUT</p>
        <h2 class="mt-4 font-display text-[1.6rem] font-bold text-ink">可以和我们谈什么</h2>
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {[
            { t: '合作与联合研究', d: '面向企业、高校与科研机构，围绕九个研究方向共建课题与联合实验室。' },
            { t: '人才培养', d: '联合培养研究生、博士后与工程实践，课题来自在研项目。' },
            { t: '成果转化', d: '面向产业场景的技术验证、样机开发与产线落地。' },
          ].map((item) => (
            <li class="flex gap-5 py-5">
              <span class="mt-1 size-1.5 shrink-0 rounded-full bg-brand-2"></span>
              <div>
                <p class="text-[14.5px] font-medium text-ink">{item.t}</p>
                <p class="mt-1.5 text-[13px] leading-relaxed text-ink-secondary">{item.d}</p>
              </div>
            </li>
          ))}
        </ul>
        <a href={u("/join")} class="mt-7 inline-flex h-11 items-center rounded-lg bg-ink px-5 text-[13.5px] font-semibold text-white">
          查看加入方式
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
