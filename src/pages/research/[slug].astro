---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/site/PageHero.astro';
import { u } from '../../lib/paths';

export async function getStaticPaths() {
  const research = await getCollection('research', ({ data }) => !data.draft);
  return research.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allResearch = (await getCollection('research', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const index = allResearch.findIndex((r) => r.id === entry.id);
const next = allResearch[(index + 1) % allResearch.length];

const products = (await getCollection('products', ({ data }) => !data.draft)).filter((p) =>
  entry.data.products.includes(p.id)
);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} transparentHeader image={entry.data.cover ?? '/images/datacenter.jpg'}>
  <PageHero
    eyebrow={`RESEARCH / ${entry.data.titleEn.toUpperCase()}`}
    title={entry.data.title}
    description={entry.data.summary}
    crumbs={[{ label: '研究方向', href: '/research' }, { label: entry.data.title }]}
    image={u(entry.data.cover ?? '/images/datacenter.webp')}
  >
    <div class="mt-9 flex flex-wrap gap-2">
      {entry.data.keywords.map((k) => (
        <span class="rounded-full border border-white/15 px-3 py-1 font-mono text-[10.5px] tracking-[0.08em] text-white/60">{k}</span>
      ))}
    </div>
  </PageHero>

  <section class="section bg-surface">
    <div class="container-page grid gap-14 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-20">
      <div>
        <div class="prose-idmt max-w-none">
          <Content />
        </div>

        {entry.data.capabilities.length > 0 && (
          <div class="mt-12">
            <h2 class="font-display text-[1.35rem] font-bold text-ink">关键能力</h2>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {entry.data.capabilities.map((cap, i) => (
                <li class="flex gap-3 rounded-xl border border-line bg-canvas p-4 text-[13.5px] leading-relaxed text-ink-secondary">
                  <span class="font-mono text-[10px] text-brand">{String(i + 1).padStart(2, '0')}</span>
                  {cap}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-line bg-canvas p-6">
          <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">AT A GLANCE</p>
          <dl class="mt-4 space-y-3 text-[13px]">
            <div class="flex justify-between gap-4">
              <dt class="text-ink-tertiary">所属方向</dt>
              <dd class="text-right font-medium text-ink">{String(index + 1).padStart(2, '0')} / {String(allResearch.length).padStart(2, '0')}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-tertiary">关联产品</dt>
              <dd class="text-right font-medium text-ink">{products.length} 项</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-tertiary">关键词</dt>
              <dd class="text-right font-medium text-ink">{entry.data.keywords.length} 个</dd>
            </div>
          </dl>
        </div>

        {products.length > 0 && (
          <div class="rounded-2xl border border-line bg-surface p-6">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">PRODUCTS</p>
            <ul class="mt-4 space-y-3">
              {products.map((p) => (
                <li>
                  <a href={u(`/products/${p.id}`)} class="group flex items-center gap-3">
                    <img src={u(p.data.image ?? '/images/datacenter.webp')} alt="" class="size-12 rounded-lg object-cover" loading="lazy" />
                    <span class="text-[13px] font-medium text-ink group-hover:text-brand">{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="rounded-2xl bg-night p-6 text-white">
          <p class="font-mono text-[10px] tracking-[0.2em] text-white/40">COLLABORATE</p>
          <p class="mt-3 text-[14px] leading-relaxed text-white/75">有课题、场景或人才合作意向？欢迎通过研究院官方渠道联系我们。</p>
          <a href={u("/contact")} class="mt-5 inline-flex h-10 items-center rounded-lg bg-white px-4 text-[13px] font-semibold text-[var(--color-ink)]">联系研究院</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-line bg-canvas py-10">
    <div class="container-page flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">NEXT AREA</p>
      <a href={u(`/research/${next.id}`)} class="group flex items-center gap-3 font-display text-[1.2rem] font-semibold text-ink hover:text-brand">
        {next.data.title}
        <span class="grid size-8 place-items-center rounded-full border border-line-strong transition-transform group-hover:translate-x-1">
          <svg viewBox="0 0 16 16" class="size-3.5" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
