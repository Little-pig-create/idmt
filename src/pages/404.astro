---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/paths';
---

<BaseLayout title="页面不存在" description="您访问的页面不存在或已迁移。">
  <section class="night relative flex min-h-[80svh] items-center overflow-hidden pt-[var(--nav-h)]">
    <div class="grid-lines absolute inset-0 opacity-40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_50%_20%,rgba(31,94,255,.2),transparent_70%)]"></div>
    <div class="container-page relative text-center">
      <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-brand-2)]">ERROR 404</p>
      <p class="mt-6 font-display text-[5rem] font-bold leading-none text-white/15">404</p>
      <h1 class="mt-2 font-display text-h1 font-bold text-white">这个页面不在研究院里</h1>
      <p class="mx-auto mt-4 max-w-md text-[14px] leading-relaxed text-white/55">
        链接可能已经迁移。你可以回到首页，或从研究方向重新开始。
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <a href={u("/")} class="inline-flex h-11 items-center rounded-lg bg-white px-5 text-[13.5px] font-semibold text-[var(--color-ink)]">返回首页</a>
        <a href={u("/research")} class="inline-flex h-11 items-center rounded-lg border border-white/20 px-5 text-[13.5px] text-white/85">研究方向</a>
      </div>
    </div>
  </section>
</BaseLayout>
