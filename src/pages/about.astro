---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import SectionHead from '../components/site/SectionHead.astro';
import Reveal from '../components/site/Reveal.tsx';
import { site } from '../data/site';
import { governance, orgGroups, centers, milestones } from '../data/org';
import { u } from '../lib/paths';
---

<BaseLayout title="关于研究院" description="数字管理技术研究院（IDMT）的定位、治理架构、组织体系与三年发展目标。" transparentHeader image="/images/lab-line.jpg">
  <PageHero
    eyebrow="ABOUT / 关于研究院"
    title="一所面向产业问题的数字技术研究院"
    description="IDMT 由高校联合社会力量共建，以「小而精」的骨干研发团队为核心，在真实产业场景中提出课题、验证技术、交付系统。"
    crumbs={[{ label: '关于研究院' }]}
    image={u('/images/lab-line.webp')}
  />

  <section class="section bg-surface">
    <div class="container-page grid gap-14 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20">
      <div>
        <p class="eyebrow">MANDATE / 使命</p>
        <h2 class="mt-5 font-display text-[2rem] font-bold leading-[1.2] tracking-[-0.025em] text-ink lg:text-[2.5rem]">
          打通从基础研究<br />到产业化的<span class="text-brand">最后一公里</span>
        </h2>
        <p class="mt-6 text-[15px] leading-[1.9] text-ink-secondary">
          研究院坚持面向未来、交叉融合、科教结合、开放创新。我们既做前沿研究，也把研究做成可运行的系统；
          既服务产业，也把真实问题带回课堂。
        </p>
        <p class="mt-4 text-[15px] leading-[1.9] text-ink-secondary">
          目标是在亚太地区成为最卓越的数字化研究院与实验室之一。
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {[
          { k: '成立', v: site.founded, u: 'YEAR' },
          { k: '研究中心', v: '6', u: 'CENTERS' },
          { k: '专业实验室', v: '10', u: 'LABS' },
          { k: '研究方向', v: '9', u: 'AREAS' },
        ].map((item) => (
          <div class="rounded-2xl border border-line bg-canvas p-6">
            <p class="font-mono text-[9.5px] tracking-[0.2em] text-ink-tertiary">{item.u}</p>
            <p class="mt-3 font-display text-[2.2rem] font-bold leading-none text-ink">{item.v}</p>
            <p class="mt-2 text-[13px] text-ink-secondary">{item.k}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-y border-line bg-canvas">
    <div class="container-page">
      <SectionHead eyebrow="GOVERNANCE / 治理架构" title="决策、评议与执行三层分离" description="理事会定方向，学术委员会守质量，管理团队负责运营。三层各司其职，避免既当运动员又当裁判。" />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {governance.map((g, i) => (
          <Reveal client:visible delay={i * 0.07}>
            <div class="h-full rounded-2xl border border-line bg-surface p-7">
              <p class="font-mono text-[10px] tracking-[0.2em] text-brand">{String(i + 1).padStart(2, '0')} / {g.role}</p>
              <h3 class="mt-3 font-display text-[1.3rem] font-bold text-ink">{g.name}</h3>
              <p class="mt-2.5 text-[13.5px] leading-relaxed text-ink-secondary">{g.desc}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-page">
      <SectionHead eyebrow="STRUCTURE / 组织体系" title="研发、转化与支撑三线并行" description="研究能力通过平台向外转化，支撑体系保证人才、期刊与实训不断档。" />
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {orgGroups.map((group) => (
          <div class="rounded-2xl border border-line p-7">
            <div class="flex items-baseline justify-between">
              <h3 class="font-display text-[1.25rem] font-bold text-ink">{group.title}</h3>
              <span class="font-mono text-[9px] tracking-[0.16em] text-ink-tertiary">{group.en}</span>
            </div>
            <ul class="mt-5 space-y-2.5">
              {group.items.map((item) => (
                <li class="flex items-center gap-2.5 text-[13.5px] text-ink-secondary">
                  <span class="size-1 rounded-full bg-brand"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-10 overflow-hidden rounded-2xl border border-line bg-canvas">
        <div class="border-b border-line px-6 py-4">
          <p class="font-mono text-[10px] tracking-[0.2em] text-ink-tertiary">SIX RESEARCH CENTERS / 六大研究中心</p>
        </div>
        <div class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
          {centers.map((c, i) => (
            <div class="bg-surface p-5">
              <p class="font-mono text-[10px] text-brand">{String(i + 1).padStart(2, '0')}</p>
              <p class="mt-2 text-[13.5px] font-medium leading-snug text-ink">{c}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="night relative overflow-hidden">
    <div class="grid-lines absolute inset-0 opacity-40"></div>
    <div class="container-page section relative">
      <SectionHead eyebrow="ROADMAP / 三年目标" title="分阶段把研究能力沉淀为组织能力" description="以科研产值、人才培养与引进为可量化抓手，逐年扩大合作半径。" tone="dark" />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {milestones.map((m, i) => (
          <div class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-7">
            <span class="absolute right-6 top-6 font-mono text-[10px] tracking-[0.16em] text-white/25">{m.year}</span>
            <h3 class="font-display text-[1.4rem] font-bold text-white">{m.title}</h3>
            <p class="mt-1 text-[12.5px] text-white/45">{m.subtitle}</p>
            <ul class="mt-7 space-y-3 border-t border-white/10 pt-5">
              {m.metrics.map((metric) => (
                <li class="flex items-baseline justify-between gap-4">
                  <span class="text-[12.5px] text-white/50">{metric.label}</span>
                  <span class="font-display text-[15px] font-semibold text-[var(--color-brand-2)]">{metric.value}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-8 text-[11.5px] text-white/30">注：以上为规划目标，非已实现业绩。</p>
    </div>
  </section>
</BaseLayout>
