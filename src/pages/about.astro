---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import AsideBox from '../components/ui/AsideBox.astro';
import { site, researchAreas } from '../data/site';
import { u } from '../lib/paths';

/** 下设研究机构：取自研究院自述材料中的机构名录。 */
const structure = [
  { name: '人工智能与无人系统研究中心', desc: '无人系统智能化设计、研发与技术转化。' },
  { name: '智慧物联网技术研究中心', desc: '泛在物联网、交通数字化与城市侧信息化系统。' },
  { name: '工业 4.0 与增材制造技术研究中心', desc: '工业仿真、3D 打印与增材制造技术。' },
  { name: '数据挖掘与云计算研究中心', desc: '云计算、数据挖掘与数据平台建设。' },
  { name: '新能源与碳中和研究所', desc: '能源管理、碳排放与节能减排技术服务。' },
  { name: '《数字亚洲》SCI&SSCI 期刊', desc: '研究院主办学术期刊（暂定名）。' },
];

/** 只列有公开报道可稽的节点；未收录的年份不代表没有活动。 */
const history = [
  { year: '2025.11', event: '承办中韩经济发展论坛数字经济分论坛（越湖论坛），并完成一批特聘教授聘任。' },
  { year: '2026.07', event: '与韩国安全文化学会等机构共同承办 2026 亚太数字产业与安全文化国际学术会议。' },
];

const toc = [
  { id: 'intro', label: '研究院简介' },
  { id: 'principles', label: '研究愿景' },
  { id: 'structure', label: '组织架构' },
  { id: 'history', label: '公开活动记录' },
  { id: 'contact', label: '联系方式' },
];
---

<BaseLayout title="研究院概况" description={`${site.name}的定位、研究愿景与组织架构。`}>
  <PageHero
    eyebrow="About"
    title="研究院概况"
    description="数字管理技术研究院（IDMT）是浙江树人学院设立的科研机构，聚焦数字技术前沿研究与成果转化。"
    crumbs={[{ label: '研究院概况' }]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_260px] lg:gap-16">
        <div class="container-prose prose-academic lg:mx-0 lg:max-w-none">
          <h2 id="intro">研究院简介</h2>
          <p>
            {site.name}（{site.nameEn}，简称 {site.shortName}）依托浙江树人学院设立，聚焦数字技术前沿研究，
            面向未来产业与关键核心技术，探索从基础研究到产业化落地的衔接路径。
          </p>
          <p>
            研究院的工作覆盖四个专业领域：{researchAreas.join('、')}。
            研究内容既包含无人系统、增材制造、工业数字化等技术侧的设计与研发，也包含智慧城市、
            未来社区、智慧医疗等场景下的平台建设与应用评估。
          </p>
          <blockquote>
            完成从基础研究到产业化的最后一公里。
          </blockquote>
          <p>
            研究院以承办国际学术会议、共建校际合作平台等方式开展对外交流，并为在校学生提供参与科研实践的机会。
          </p>

          <h2 id="principles">研究愿景</h2>
          <p>研究院的工作原则是四个坚持：</p>
          <ul>
            <li>
              <strong>坚持面向未来。</strong>加强对数字融合发展趋势研判，瞄准前沿性、革命性、颠覆性技术发展，
              培养未来科技创新领军人才。
            </li>
            <li>
              <strong>坚持交叉融合。</strong>主动打破传统学科壁垒，促进理工结合、工工交叉、工文渗透、医工融合，
              依据学科优势聚焦数字技术领域。
            </li>
            <li>
              <strong>坚持科教结合。</strong>强化科研育人功能，把最新科研成果转化为教学内容，
              为学生接触学科前沿、开展科研实践创造条件。
            </li>
            <li>
              <strong>坚持开放创新。</strong>在开放中实现中外交流、汇聚各方资源、跨越院系鸿沟、促进交叉融合。
            </li>
          </ul>

          <h2 id="structure">组织架构</h2>
          <p>
            研究院设理事会与专家学术委员会，理事会下设管理团队，负责研究方向的审议与日常运行；
            具体研究工作由各研究中心与研究所承担。
          </p>
          <div class="mt-8 overflow-hidden rounded-md border border-line">
            <table class="w-full border-collapse text-ui">
              <caption class="sr-only">研究院组织架构</caption>
              <thead class="bg-surface-subtle">
                <tr>
                  <th scope="col" class="w-56 px-5 py-3 text-left font-medium text-ink">机构</th>
                  <th scope="col" class="px-5 py-3 text-left font-medium text-ink">职责</th>
                </tr>
              </thead>
              <tbody>
                {
                  structure.map((item) => (
                    <tr class="border-t border-line">
                      <th scope="row" class="px-5 py-3 text-left font-medium text-ink">{item.name}</th>
                      <td class="px-5 py-3 text-ink-secondary">{item.desc}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h2 id="history">公开活动记录</h2>
          <p>以下节点有公开报道可稽，未收录的年份不代表研究院没有开展活动。</p>
          <ol class="mt-6 space-y-0">
            {
              history.map((item) => (
                <li class="grid grid-cols-[4rem_1fr] gap-4 border-t border-line py-4">
                  <span class="numeric text-ui font-medium text-accent">{item.year}</span>
                  <span class="text-ui leading-relaxed text-ink-secondary">{item.event}</span>
                </li>
              ))
            }
          </ol>

          <h2 id="contact">联系方式</h2>
          <p>
            地址：{site.address}
            <br />
            电话与邮箱等对外联系方式尚未在本站核定，请经由
            <a href={u('/contact')}>联系我们</a>所列的学校公开渠道转达。
          </p>
        </div>

        <aside class="lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
          <AsideBox title="本页目录">
            <nav aria-label="本页目录">
              <ul class="space-y-2">
                {
                  toc.map((item) => (
                    <li>
                      <a href={`#${item.id}`} class="text-ui text-ink-secondary transition-colors duration-150 hover:text-accent">
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </AsideBox>

          <AsideBox title="关键数字">
            <ul>
              <li class="flex items-baseline justify-between gap-3 border-b border-line py-2 text-ui">
                <span class="text-ink-secondary">专业领域</span>
                <span class="numeric text-ink">{researchAreas.length}</span>
              </li>
              <li class="flex items-baseline justify-between gap-3 border-b border-line py-2 text-ui">
                <span class="text-ink-secondary">研究机构</span>
                <span class="numeric text-ink">{structure.length}</span>
              </li>
              <li class="flex items-baseline justify-between gap-3 border-b border-line py-2 text-ui">
                <span class="text-ink-secondary">依托单位</span>
                <span class="text-ink">浙江树人学院</span>
              </li>
            </ul>
          </AsideBox>

          <AsideBox title="相关入口">
            <ul class="space-y-2 text-ui">
              <li><a href={u('/research')} class="link">研究方向</a></li>
              <li><a href={u('/people')} class="link">研究团队</a></li>
              <li><a href={u('/events')} class="link">学术活动</a></li>
              <li><a href={u('/contact')} class="link">联系我们</a></li>
            </ul>
          </AsideBox>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
