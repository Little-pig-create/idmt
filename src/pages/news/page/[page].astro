---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import AsideBox from '../../../components/ui/AsideBox.astro';
import NewsList from '../../../components/content/NewsList.astro';
import NoticeList from '../../../components/content/NoticeList.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { paginateArray, PAGE_SIZE } from '../../../lib/pagination';
import { u } from '../../../lib/paths';

export async function getStaticPaths() {
  const all = await getCollection('news', ({ data }) => !data.draft);
  const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;

const all = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const { items, current, totalPages } = paginateArray(all, Number(page));

const notices = (await getCollection('notices', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const noticeItems = notices.map((n) => ({
  title: n.data.title,
  date: n.data.date,
  href: `/notices#${n.id}`,
  category: n.data.category,
  pinned: n.data.pinned,
}));
---

<BaseLayout
  title={`新闻动态 · 第 ${current} 页`}
  description="数字管理研究院的最新进展、合作与学术活动公告。"
>
  <PageHero
    eyebrow="News"
    title="新闻动态"
    description="研究院的研究进展、合作动态与公告。"
    crumbs={[
      { label: '成果与动态', href: '/publications' },
      { label: '新闻动态', href: '/news' },
      { label: `第 ${current} 页` },
    ]}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_320px] lg:gap-16">
        <div>
          <SectionHeading
            eyebrow="Latest"
            title={`全部新闻 · 第 ${current} 页`}
            moreHref="/news"
            moreLabel="回到首页"
          />
          <NewsList items={items} />
          <Pagination currentPage={current} totalPages={totalPages} basePath="/news" />
        </div>

        <aside class="lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
          <AsideBox title="通知公告">
            <NoticeList items={noticeItems} compact />
            <a href={u('/notices')} class="mt-3 inline-block text-ui text-accent hover:underline">
              全部公告 →
            </a>
          </AsideBox>

          <AsideBox title="相关入口">
            <ul class="space-y-2 text-ui">
              <li><a href={u('/events')} class="link">学术活动</a></li>
              <li><a href={u('/publications')} class="link">学术成果</a></li>
              <li><a href={u('/research')} class="link">研究方向</a></li>
            </ul>
          </AsideBox>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
