---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import AsideBox from '../../components/ui/AsideBox.astro';
import NewsList from '../../components/content/NewsList.astro';
import NoticeList from '../../components/content/NoticeList.astro';
import Pagination from '../../components/ui/Pagination.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { paginateArray } from '../../lib/pagination';
import { u } from '../../lib/paths';

const all = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const { items, current, totalPages } = paginateArray(all, 1);

const notices = (await getCollection('notices', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 5);

const noticeItems = notices.map((n) => ({
  title: n.data.title,
  date: n.data.date,
  href: `/notices#${n.id}`,
  category: n.data.category,
  pinned: n.data.pinned,
}));

const tagCounts = new Map<string, number>();
for (const item of all) {
  for (const t of item.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
---

<BaseLayout
  title="新闻动态"
  description="数字管理研究院的最新进展、合作与学术活动公告。"
>
  <PageHero
    eyebrow="News"
    title="新闻动态"
    description="研究院的研究进展、合作动态与公告。"
    crumbs={[{ label: '成果与动态', href: '/publications' }, { label: '新闻动态' }]}
  />

  <section class="section">
    <div class="container-page">
      {
        all.length === 0 ? (
          <EmptyState
            title="暂无新闻"
            description="研究院尚未发布任何新闻动态。"
            suggestions={[
              { label: '查看学术成果', href: '/publications' },
              { label: '查看学术活动', href: '/events' },
            ]}
          />
        ) : (
          <div class="grid gap-12 lg:grid-cols-[1fr_320px] lg:gap-16">
            <div>
              <SectionHeading
                eyebrow="Latest"
                title="全部新闻"
                moreHref="/publications"
                moreLabel="学术成果"
              />
              <NewsList items={items} showFeatured />
              <Pagination currentPage={current} totalPages={totalPages} basePath="/news" />
            </div>

            <aside class="lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)] lg:self-start">
              <AsideBox title="通知公告">
                <NoticeList items={noticeItems} compact />
                <a href={u('/notices')} class="mt-3 inline-block text-ui text-accent hover:underline">
                  全部公告 →
                </a>
              </AsideBox>

              <AsideBox title="热门标签">
                <ul class="flex flex-wrap gap-1.5">
                  {
                    tags.map(([tag, count]) => (
                      <li>
                        <a href={u(`/search?q=${encodeURIComponent(tag)}`)} class="tag tag-quiet transition-colors duration-150 hover:bg-accent-soft hover:text-accent-ink">
                          {tag}
                          <span class="numeric ml-1 text-ink-tertiary">{count}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </AsideBox>

              <AsideBox title="相关入口">
                <ul class="space-y-2 text-ui">
                  <li><a href={u('/events')} class="link">学术活动</a></li>
                  <li><a href={u('/publications')} class="link">学术成果</a></li>
                  <li><a href={u('/research')} class="link">研究方向</a></li>
                  <li><a href={u('/datasets')} class="link">数据集与资源</a></li>
                </ul>
              </AsideBox>
            </aside>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
