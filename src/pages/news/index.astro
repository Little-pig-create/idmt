---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/site/PageHero.astro';
import { u } from '../../lib/paths';

const news = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = news.find((n) => n.data.featured) ?? news[0];
const rest = news.filter((n) => n.id !== featured?.id);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="新闻动态" description="IDMT 研究进展、产业合作与学术活动报道。" transparentHeader image="/images/lab-line.jpg">
  <PageHero
    eyebrow="NEWS / 新闻动态"
    title="研究进展与产业动态"
    description="来自实验室、产线与合作现场的第一手进展。我们不发布没有数据支撑的消息。"
    crumbs={[{ label: '新闻动态' }]}
    image={u('/images/lab-line.webp')}
    size="compact"
  />

  <section class="section bg-canvas">
    <div class="container-page">
      {featured && (
        <a href={u(`/news/${featured.id}`)} class="group grid overflow-hidden rounded-2xl border border-line bg-surface lg:grid-cols-2">
          <div class="relative aspect-[16/10] overflow-hidden lg:aspect-auto">
            <img src={u(featured.data.cover ?? '/images/lab-line.webp')} alt={featured.data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
          </div>
          <div class="flex flex-col justify-center p-7 lg:p-10">
            <div class="flex items-center gap-3 font-mono text-[10px] tracking-[0.14em] text-ink-tertiary">
              <span>{fmt(featured.data.date)}</span>
              <span class="h-px w-6 bg-line-strong"></span>
              <span class="text-brand">{featured.data.tags[0]}</span>
            </div>
            <h2 class="mt-3 font-display text-[1.6rem] font-bold leading-snug tracking-[-0.01em] text-ink group-hover:text-brand lg:text-[1.9rem]">
              {featured.data.title}
            </h2>
            <p class="mt-3 text-[14.5px] leading-relaxed text-ink-secondary">{featured.data.summary}</p>
            <span class="mt-6 text-[12.5px] font-medium text-brand">阅读全文 →</span>
          </div>
        </a>
      )}

      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((item) => (
          <a href={u(`/news/${item.id}`)} class="group card-lift flex flex-col overflow-hidden rounded-2xl border border-line bg-surface">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={u(item.data.cover ?? '/images/datacenter.webp')} alt={item.data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-2.5 font-mono text-[10px] tracking-[0.1em] text-ink-tertiary">
                <span>{fmt(item.data.date)}</span>
                <span class="text-brand">{item.data.tags[0]}</span>
              </div>
              <h3 class="mt-2 font-display text-[1.05rem] font-semibold leading-snug text-ink group-hover:text-brand">{item.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-[13px] leading-relaxed text-ink-secondary">{item.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
