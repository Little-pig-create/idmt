---
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}

import { site } from '../../data/site';

const { title, description = site.description, type = 'website', publishedAt } = Astro.props;

// 搜索引擎通常在 ~60 字符处截断标题。英文论文标题往往很长，
// 超出时对「页面标题」部分截断（保留院名后缀），避免出现无意义的断句。
const MAX_TITLE = 60;
const suffix = ` · ${site.name}`;
let pageTitle = title;
if (title !== site.name) {
  const budget = MAX_TITLE - suffix.length;
  pageTitle = title.length > budget ? `${title.slice(0, budget - 1)}…${suffix}` : `${title}${suffix}`;
}
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} · 动态`} href={new URL('/rss.xml', Astro.site ?? site.url).href} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="zh_CN" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
