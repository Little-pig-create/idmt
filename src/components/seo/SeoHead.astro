---
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /**
   * 学术成果页的 Highwire Press 元数据（Google Scholar 抓取依据）。
   * 只有 publications 详情页传；其余页面不传，不输出任何 citation_* 标签。
   */
  citation?: CitationSource;
}

import { site } from '../../data/site';
import { toCitationMeta, type CitationSource } from '../../lib/citation';

const { title, description = site.description, type = 'website', publishedAt, citation } = Astro.props;

// 搜索引擎通常在 ~60 字符处截断标题。英文论文标题往往很长，
// 超出时对「页面标题」部分截断（保留院名后缀），避免出现无意义的断句。
const MAX_TITLE = 60;
const suffix = ` · ${site.name}`;
let pageTitle = title;
if (title !== site.name) {
  const budget = MAX_TITLE - suffix.length;
  pageTitle = title.length > budget ? `${title.slice(0, budget - 1)}…${suffix}` : `${title}${suffix}`;
}
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/**
 * citation_author 必须一人一条 <meta>，不能合并成一个逗号串 ——
 * Google Scholar 的解析器按标签出现次数收集作者。
 */
const citationTags = citation ? toCitationMeta(citation) : [];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} · 动态`} href={new URL('/rss.xml', Astro.site ?? site.url).href} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="zh_CN" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

{/* ---------- Highwire Press：学术检索系统的元数据来源 ---------- */}
{
  citationTags.map((tag) => (
    <meta name={tag.name} content={tag.content} />
  ))
}
