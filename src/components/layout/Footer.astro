---
import { site } from '../../data/site';
import { friendLinks, systemLinks } from '../../data/links';
import { u } from '../../lib/paths';

const year = new Date().getFullYear();

const columns = [
  {
    title: '研究院概况',
    links: [
      { label: '研究院简介', href: '/about' },
      { label: '组织架构', href: '/about#structure' },
      { label: '公开活动记录', href: '/about#history' },
      { label: '联系我们', href: '/contact' },
    ],
  },
  {
    title: '研究',
    links: [
      { label: '研究方向', href: '/research' },
      { label: '研究团队', href: '/people' },
      { label: '科研项目', href: '/projects' },
      { label: '数据集与资源', href: '/datasets' },
    ],
  },
  {
    title: '成果与动态',
    links: [
      { label: '学术成果', href: '/publications' },
      { label: '新闻动态', href: '/news' },
      { label: '学术活动', href: '/events' },
      { label: '通知公告', href: '/notices' },
      { label: 'RSS 订阅', href: '/rss.xml' },
    ],
  },
  {
    title: '加入我们',
    links: [
      { label: '学生科研实践', href: '/join#practice' },
      { label: '研究生招生', href: '/join#admission' },
      { label: '岗位招聘', href: '/join#positions' },
      { label: '联系我们', href: '/contact' },
    ],
  },
];
---

<footer class="mt-auto border-t border-line bg-surface">
  {/* 友情链接 */}
  <div class="border-b border-line bg-surface-subtle">
    <div class="container-page flex flex-wrap items-center gap-x-4 gap-y-2 py-3">
      <p class="eyebrow shrink-0">友情链接</p>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          friendLinks.map((l) => (
            <li>
              <a
                href={u(l.href)}
                title={l.desc}
                rel={l.href.startsWith('http') ? 'noopener' : undefined}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                class="text-meta text-ink-secondary transition-colors duration-150 hover:text-accent"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page py-12 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr_1fr_1fr_1.3fr]">
      <div>
        <p class="font-[family-name:var(--font-serif-cjk)] text-lg font-semibold text-ink">
          {site.name}
        </p>
        <p class="numeric mt-1 text-[0.625rem] tracking-[0.18em] text-ink-tertiary">
          {site.nameEn.toUpperCase()}
        </p>
        <p class="mt-4 max-w-xs text-ui leading-relaxed text-ink-secondary">
          {site.tagline}。依托浙江树人学院，聚焦数字技术前沿研究与成果转化。
        </p>
        <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1">
          {
            systemLinks.map((l) => (
              <li>
                <a href={u(l.href)} class="text-meta text-ink-secondary transition-colors duration-150 hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="eyebrow mb-3">{col.title}</p>
            <ul class="space-y-2">
              {col.links.map((l) => (
                <li>
                  <a
                    href={u(l.href)}
                    class="text-ui text-ink-secondary transition-colors duration-150 hover:text-accent"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <p class="eyebrow mb-3">联系</p>
        <address class="space-y-2 text-ui not-italic text-ink-secondary">
          <p>{site.address}</p>
          {site.postcode && <p class="numeric">邮编 {site.postcode}</p>}
          {
            site.phone && (
              <p>
                <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="numeric transition-colors duration-150 hover:text-accent">
                  {site.phone}
                </a>
              </p>
            )
          }
          {
            site.email && (
              <p>
                <a href={`mailto:${site.email}`} class="transition-colors duration-150 hover:text-accent">
                  {site.email}
                </a>
              </p>
            )
          }
          {(!site.email || !site.phone) && (
            <p>联系方式以浙江树人学院官网公布为准。</p>
          )}
        </address>
      </div>
    </div>
  </div>

  {/* 底条 */}
  <div class="stat-band">
    <div class="container-page flex flex-col gap-2 py-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-meta">
        © {year} {site.name}　{site.filing}
      </p>
      <p class="text-meta" style="color: var(--color-on-masthead-muted)" data-cfg="footer-note">
        内容以浙江树人学院及研究院正式发布为准
      </p>
    </div>
  </div>
</footer>
