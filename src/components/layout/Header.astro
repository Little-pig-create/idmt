---
import { nav } from '../../data/nav';
import { site } from '../../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

/**
 * 首页的 h1 由报头院名承担（机构门户惯例，与 cas.cn 一致）；
 * 内页 h1 由 PageHero 承担，此时报头降级为普通 span，避免出现两个 h1。
 */
const isHome = pathname === '/';

const quickLinks = [
  { id: 'quickJoin', label: '研究生招生', href: '/join' },
  { id: 'quickContact', label: '联系我们', href: '/contact' },
];
---

<header class="site-header" data-site-header>
  {/* ============ 顶部工具条 ============ */}
  <div class="utility-bar">
    <div class="container-page flex items-center justify-between gap-4">
      <p class="truncate text-meta text-ink-secondary">
        {site.name}·学术门户
      </p>
      <nav aria-label="辅助功能" class="flex shrink-0 items-center gap-1 text-meta">
        <span class="utility-tag text-accent" data-cfg-el="languageSwitch" data-cfg-route="*" aria-current="true">中文</span>
        <span aria-hidden="true" class="utility-sep">|</span>
        <span class="utility-tag text-ink-tertiary" title="英文版建设中">EN</span>
        <span aria-hidden="true" class="utility-sep">|</span>
        <a href="/search" class="utility-link" data-cfg-el="searchTrigger" data-cfg-route="*" data-cfg-label>
          全站搜索
        </a>
        <span aria-hidden="true" class="utility-sep">|</span>
        <a href="/admin" class="utility-link" data-cfg-el="adminEntry" data-cfg-route="*" data-cfg-label>
          内容发布后台
        </a>
      </nav>
    </div>
  </div>

  {/* ============ 报头 ============ */}
  <div class="masthead">
    <div class="container-page flex items-center justify-between gap-6">
      <a href="/" class="brand" aria-label={`${site.name} 首页`}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="40" height="40" focusable="false">
            <rect x="0" y="0" width="40" height="40" rx="6" fill="var(--color-fig-a)"></rect>
            <g fill="var(--color-ink-invert)" opacity="0.92">
              <rect x="9" y="23" width="5" height="8"></rect>
              <rect x="17.5" y="16" width="5" height="15"></rect>
              <rect x="26" y="9" width="5" height="22"></rect>
            </g>
          </svg>
        </span>
        <div class="brand-text">
          {isHome ? <h1 class="brand-cn" data-cfg="logo-text">{site.name}</h1> : <span class="brand-cn" data-cfg="logo-text">{site.name}</span>}
          <span class="brand-en" data-cfg="logo-subtext">{site.nameEn}</span>
        </div>
      </a>

      <div class="masthead-side">
        <form role="search" method="get" action="/search" class="masthead-search" data-cfg="search-form" data-cfg-el="searchForm" data-cfg-route="*">
          <label for="masthead-q" class="sr-only">搜索本站内容</label>
          <input
            id="masthead-q"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="搜索成果、人员、新闻与活动"
            class="masthead-search-input"
          />
          <button type="submit" class="masthead-search-btn" aria-label="搜索">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        </form>

        <nav aria-label="快捷入口" class="masthead-links">
          {
            quickLinks.map((l) => (
              <a href={l.href} class="masthead-link" data-cfg-el={l.id} data-cfg-route="*" data-cfg-label>{l.label}</a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>

</header>

{/* ============ 吸顶主导航 ============
     刻意放在 <header> 之外：sticky 元素只在父级包含块内生效，
     若留在 header 内，滚过报头后导航会随之一同滚走。 */}
<div class="nav-wrap" data-nav-wrap>
    <div class="container-page flex items-center gap-1">
      <nav aria-label="主导航" class="hidden items-center gap-0.5 lg:flex">
        <a
          href="/"
          data-cfg-nav="/"
          aria-current={isActive('/') ? 'page' : undefined}
          class:list={[
            'nav-item',
            isActive('/') ? 'nav-item-active' : '',
          ]}
        >
          首页
        </a>

        {
          nav.map((entry, i) => (
            <div class="relative" data-cfg-nav={entry.href}>
              {entry.groups ? (
                <button
                  type="button"
                  data-nav-trigger={i}
                  aria-expanded="false"
                  aria-controls={`nav-panel-${i}`}
                  class:list={[
                    'nav-item nav-item-btn',
                    isActive(entry.href) ? 'nav-item-active' : '',
                  ]}
                >
                  {entry.label}
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
              ) : (
                <a
                  href={entry.href}
                  aria-current={isActive(entry.href) ? 'page' : undefined}
                  class:list={['nav-item', isActive(entry.href) ? 'nav-item-active' : '']}
                >
                  {entry.label}
                </a>
              )}
            </div>
          ))
        }
      </nav>

      <div class="ml-auto flex shrink-0 items-center gap-1">
        <button
          type="button"
          data-search-open
          data-cfg="search-toggle"
          class="icon-btn lg:hidden"
          aria-label="全站搜索"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>

        <button
          type="button"
          data-drawer-toggle
          class="icon-btn lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          aria-label="打开导航菜单"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>
    </div>

    {/* Mega Menu 面板容器 */}
    <div class="mega-wrap" data-mega-wrap hidden>
      <div class="container-page pb-6 pt-2">
        {
          nav.map((entry, i) =>
            entry.groups ? (
              <div id={`nav-panel-${i}`} data-nav-panel={i} hidden>
                <div class="grid gap-8 border-t border-line pt-6 sm:grid-cols-2 lg:grid-cols-4">
                  {entry.groups.map((group) => (
                    <div>
                      <p class="eyebrow mb-3">{group.title}</p>
                      <ul class="space-y-1">
                        {group.items.map((item) => (
                          <li data-cfg-nav-item={item.href.split('#')[0]}>
                            <a
                              href={item.href}
                              class="block rounded-md px-2 py-2 transition-colors duration-150 hover:bg-accent-soft"
                            >
                              <span class="block text-ui font-medium text-ink">{item.label}</span>
                              {item.desc && (
                                <span class="mt-0.5 block text-meta text-ink-tertiary">{item.desc}</span>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            ) : null
          )
        }
      </div>
    </div>
  </div>

{/* 移动端抽屉 */}
<div class="drawer-scrim" data-drawer-scrim hidden></div>
<aside
  id="mobile-drawer"
  class="mobile-drawer"
  data-drawer
  aria-label="移动端导航"
  aria-hidden="true"
>
  <div class="drawer-head">
    <span class="font-[family-name:var(--font-serif-cjk)] font-semibold text-ink">{site.name}</span>
    <button
      type="button"
      data-drawer-close
      class="icon-btn"
      aria-label="关闭导航菜单"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <nav class="overflow-y-auto p-4" aria-label="移动端主导航">
    <a href="/" data-cfg-nav="/" class="drawer-link">首页</a>
    {
      nav.map((entry) =>
        entry.groups ? (
          <details class="border-b border-line py-1" data-cfg-nav={entry.href}>
            <summary class="flex min-h-11 cursor-pointer items-center justify-between text-ui font-medium text-ink">
              {entry.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div class="pb-2">
              {entry.groups.map((group) => (
                <div class="pt-2">
                  <p class="eyebrow mb-1 px-2">{group.title}</p>
                  <ul>
                    {group.items.map((item) => (
                      <li data-cfg-nav-item={item.href.split('#')[0]}>
                        <a href={item.href} class="block rounded-md px-2 py-2.5 text-ui text-ink-secondary hover:bg-accent-soft hover:text-ink">
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        ) : (
          <a href={entry.href} data-cfg-nav={entry.href} class="drawer-link">{entry.label}</a>
        )
      )
    }
  </nav>
</aside>

{/* 搜索弹层 */}
<div class="search-scrim" data-search-scrim hidden></div>
<div
  class="search-dialog"
  data-search-dialog
  role="dialog"
  aria-modal="true"
  aria-label="全站搜索"
  hidden
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-ink-tertiary" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="search"
      data-search-input
      placeholder="搜索成果、人员、新闻、活动…"
      class="min-h-14 w-full bg-transparent text-ui text-ink outline-none placeholder:text-ink-tertiary"
      aria-label="搜索关键词"
      autocomplete="off"
    />
    <button type="button" data-search-close class="numeric shrink-0 rounded-sm border border-line px-1.5 py-0.5 text-[0.6875rem] text-ink-tertiary">
      Esc
    </button>
  </div>
  <div class="max-h-[60vh] overflow-y-auto p-2" data-search-results>
    <p class="px-3 py-6 text-center text-ui text-ink-tertiary">
      输入关键词开始搜索
    </p>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 50;
  }

  /* ---------- 顶部工具条 ---------- */
  .utility-bar {
    height: var(--utility-h);
    background-color: var(--color-utility);
    border-bottom: 1px solid var(--color-line);
  }

  .utility-bar > .container-page {
    height: 100%;
  }

  /* ---------- 工具条链接：点击区补齐到 44×44 ----------
     工具条自身只有 34px 高（--utility-h），文字链接实测仅 18px 高，
     远低于 DESIGN_SYSTEM §1.5 的 44×44 标准，22 个页面全部受影响。
     做法：链接改为 inline-flex 垂直居中 + min-height 44px，
     用负 margin 抵消它对工具条高度的撑开，保持 34px 视觉高度不变。
     这样点击区向上下各外扩 5px，不影响版面。 */
  .utility-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    margin-block: -0.3125rem;
    font-size: var(--text-meta);
    color: var(--color-ink-secondary);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .utility-link:hover {
    color: var(--color-accent);
  }

  .utility-link:active {
    color: var(--color-accent-ink);
  }

  /* 语言标识与分隔符同样按 44px 对齐，避免视觉上参差 */
  .utility-tag {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -0.3125rem;
    font-size: var(--text-meta);
  }

  .utility-sep {
    color: var(--color-line-strong);
  }

  @media (max-width: 639px) {
    .utility-bar {
      display: none;
    }
  }

  /* ---------- 报头 ---------- */
  .masthead {
    background-color: var(--color-masthead);
    color: var(--color-ink-invert);
  }

  .masthead > .container-page {
    min-height: var(--masthead-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    color: var(--color-ink-invert);
  }

  .brand-mark {
    flex: none;
    display: block;
    line-height: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-cn {
    margin: 0;
    font-family: var(--font-serif-cjk);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--color-on-masthead);
    white-space: nowrap;
  }

  .brand-en {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-masthead-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .masthead-side {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  /* 点击区补齐到 44px（DESIGN_SYSTEM §1.5）：
     此前输入框 38px、按钮 38×40，全部页面受影响。
     外层有 overflow:hidden，故容器与内部元素必须一起长高，否则会被裁掉。 */
  .masthead-search {
    display: flex;
    align-items: center;
    width: clamp(200px, 24vw, 300px);
    min-height: 44px;
    border: 1px solid var(--color-on-masthead-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .masthead-search:focus-within {
    border-color: var(--color-on-masthead-line-strong);
  }

  .masthead-search-input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding-inline: 0.875rem;
    background: transparent;
    color: var(--color-on-masthead);
    font-size: var(--text-ui);
    outline: none;
  }

  .masthead-search-input::placeholder {
    color: var(--color-on-masthead-faint);
  }

  .masthead-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    color: var(--color-on-masthead-soft);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .masthead-search-btn:hover {
    color: var(--color-on-masthead);
  }

  .masthead-search-btn:active {
    color: var(--color-on-masthead-faint);
    background-color: var(--color-on-masthead-line);
  }

  .masthead-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* 点击区补齐到 44×44：此前实测仅 21px 高，低于 DESIGN_SYSTEM §1.5 标准。
     报头有 min-height 84px，链接纵向延伸到 44px 不会撑开版面。 */
  .masthead-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    font-size: var(--text-ui);
    color: var(--color-on-masthead-soft);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .masthead-link:hover {
    color: var(--color-on-masthead);
  }

  .masthead-link:active {
    color: var(--color-on-masthead-faint);
  }

  @media (max-width: 1023px) {
    .masthead-search {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .masthead-links {
      display: none;
    }
    .brand-cn {
      font-size: 1.125rem;
    }
  }

  /* ---------- 吸顶导航 ---------- */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-canvas) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .nav-wrap > .container-page {
    height: var(--nav-h);
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: var(--nav-h);
    padding-inline: 0.875rem;
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--color-ink-secondary);
    white-space: nowrap;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .nav-item:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-line-strong);
  }

  .nav-item-active,
  .nav-item-active:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .nav-item-btn {
    border-bottom-color: transparent;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    border-radius: var(--radius-md);
    color: var(--color-ink-secondary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .icon-btn:hover {
    background-color: var(--color-surface-subtle);
    color: var(--color-ink);
  }

  .mega-wrap {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    box-shadow: var(--shadow-menu);
    animation: mega-in var(--duration-normal) var(--ease-standard) both;
  }

  @keyframes mega-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .drawer-scrim,
  .search-scrim {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--color-scrim);
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 70;
    width: min(340px, 88vw);
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-line);
    transform: translateX(-100%);
    transition: transform var(--duration-slow) var(--ease-standard);
    display: flex;
    flex-direction: column;
  }

  .mobile-drawer[data-open='true'] {
    transform: none;
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1rem;
    height: var(--nav-h);
    border-bottom: 1px solid var(--color-line);
  }

  .drawer-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--color-ink);
  }

  .search-dialog {
    position: fixed;
    top: 12vh;
    left: 50%;
    z-index: 70;
    width: min(640px, calc(100vw - 2rem));
    transform: translateX(-50%);
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-dialog);
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-wrap {
      animation: none;
    }
    .mobile-drawer {
      transition: none;
    }
  }
</style>

<script>
  // ============================================================
  // 报头交互 —— View Transitions 安全版
  //
  // 站点启用了 <ClientRouter />：客户端跳转时 <body> 内 DOM 会被整体替换，
  // 而模块脚本只在首次加载时执行一次。因此：
  //   1. 任何元素查询都必须写在函数内部，换页后重新取一次；
  //   2. initHeader() 由 astro:page-load 驱动（首次加载与每次换页都会触发），
  //      并给已绑定的节点打上 data-hb 标记，重复调用不会产生重复监听；
  //   3. 顶层只保留与 DOM 无关的缓存（搜索索引、防抖句柄、焦点记忆）。
  // ============================================================

  type SearchDoc = { title: string; url: string; kind: string; summary: string; tags: string[] };

  const sel = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s);
  const selAll = <T extends Element = HTMLElement>(s: string) =>
    Array.from(document.querySelectorAll<T>(s));

  let searchIndex: SearchDoc[] | null = null;
  let lastFocused: Element | null = null;
  let debounceTimer: number | undefined;
  let openIndex: number | null = null;
  let openedByClick = false;

  // ---------- Mega Menu ----------
  // openedByClick 用来区分「鼠标悬停打开」和「点击打开」。
  // 桌面端 mouseenter 会先于 click 触发，若 click 一律做切换，
  // 用户悬停打开面板后再点击就会被立刻关掉——等于点不开。
  function openPanel(i: number, viaClick = false) {
    if (openIndex === i) {
      if (viaClick) openedByClick = true;
      return;
    }
    closePanel();
    openIndex = i;
    openedByClick = viaClick;
    const panel = sel(`[data-nav-panel="${i}"]`);
    if (panel) panel.hidden = false;
    const megaWrap = sel('[data-mega-wrap]');
    if (megaWrap) megaWrap.hidden = false;
    sel(`[data-nav-trigger="${i}"]`)?.setAttribute('aria-expanded', 'true');
  }

  function closePanel() {
    if (openIndex === null) return;
    selAll('[data-nav-panel]').forEach((p) => (p.hidden = true));
    const megaWrap = sel('[data-mega-wrap]');
    if (megaWrap) megaWrap.hidden = true;
    selAll('[data-nav-trigger]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
    openIndex = null;
    openedByClick = false;
  }

  // ---------- 移动端抽屉 ----------
  function setDrawer(open: boolean) {
    const drawer = sel('[data-drawer]');
    const drawerScrim = sel('[data-drawer-scrim]');
    const drawerToggle = sel<HTMLButtonElement>('[data-drawer-toggle]');
    if (!drawer || !drawerScrim || !drawerToggle) return;
    drawer.dataset.open = String(open);
    drawer.setAttribute('aria-hidden', String(!open));
    drawerToggle.setAttribute('aria-expanded', String(open));
    drawerScrim.hidden = !open;
    if (open) sel<HTMLButtonElement>('[data-drawer-close]')?.focus();
    else drawerToggle.focus();
  }

  // ---------- 搜索 ----------
  async function loadIndex(): Promise<SearchDoc[]> {
    if (searchIndex) return searchIndex;
    try {
      const res = await fetch('/search-index.json');
      searchIndex = res.ok ? await res.json() : [];
    } catch {
      searchIndex = [];
    }
    return searchIndex;
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
    );
  }

  function renderResults(docs: SearchDoc[], query: string) {
    const searchResults = sel('[data-search-results]');
    if (!searchResults) return;
    if (docs.length === 0) {
      searchResults.innerHTML = `
        <div class="px-3 py-8 text-center">
          <p class="text-ui text-ink">没有找到与「${escapeHtml(query)}」匹配的内容</p>
          <p class="mt-2 text-meta text-ink-tertiary">建议尝试更短的关键词，或浏览
            <a class="link" href="/publications">学术成果</a>、
            <a class="link" href="/people">研究团队</a>、
            <a class="link" href="/news">新闻动态</a>
          </p>
        </div>`;
      return;
    }
    searchResults.innerHTML = docs
      .slice(0, 12)
      .map(
        (d) => `
        <a href="${d.url}" class="block rounded-md px-3 py-3 transition-colors duration-150 hover:bg-accent-soft">
          <div class="flex items-center gap-2">
            <span class="tag">${escapeHtml(d.kind)}</span>
            <span class="text-meta text-ink-tertiary">${escapeHtml(d.summary)}</span>
          </div>
          <p class="mt-1.5 text-ui font-medium text-ink">${escapeHtml(d.title)}</p>
        </a>`
      )
      .join('');
  }

  async function runSearch(q: string) {
    const query = q.trim();
    if (!query) {
      if (searchResults)
        searchResults.innerHTML =
          '<p class="px-3 py-6 text-center text-ui text-ink-tertiary">输入关键词开始搜索</p>';
      return;
    }
    const docs = await loadIndex();
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    const scored = docs
      .map((d) => {
        const haystack = `${d.title} ${d.summary} ${d.tags.join(' ')} ${d.kind}`.toLowerCase();
        const score = terms.reduce((acc, t) => acc + (haystack.includes(t) ? 1 : 0), 0);
        return { d, score };
      })
      .filter((x) => x.score === terms.length)
      .sort((a, b) => b.score - a.score)
      .map((x) => x.d);
    renderResults(scored, query);
  }

  function openSearch() {
    const searchDialog = sel('[data-search-dialog]');
    const searchScrim = sel('[data-search-scrim]');
    if (!searchDialog || !searchScrim) return;
    lastFocused = document.activeElement;
    searchDialog.hidden = false;
    searchScrim.hidden = false;
    const searchInput = sel<HTMLInputElement>('[data-search-input]');
    searchInput?.focus();
    searchInput?.select();
  }

  function closeSearch() {
    const searchDialog = sel('[data-search-dialog]');
    const searchScrim = sel('[data-search-scrim]');
    if (!searchDialog || !searchScrim) return;
    searchDialog.hidden = true;
    searchScrim.hidden = true;
    (lastFocused as HTMLElement | null)?.focus?.();
  }

  // ---------- 初始化（换页后重新执行） ----------
  function initHeader() {
    // 换页后面板状态需要归零，否则 openIndex 会指向上一页遗留的索引
    openIndex = null;
    openedByClick = false;

    // --- Mega Menu ---
    const triggers = selAll<HTMLButtonElement>('[data-nav-trigger]');
    triggers.forEach((trigger) => {
      if (trigger.dataset.hb === '1') return; // 已绑定过，跳过（幂等）
      trigger.dataset.hb = '1';
      const i = Number(trigger.dataset.navTrigger);
      trigger.addEventListener('click', () =>
        openedByClick && openIndex === i ? closePanel() : openPanel(i, true)
      );
      trigger.addEventListener('mouseenter', () => openPanel(i));
      trigger.addEventListener('focus', () => openPanel(i));
    });

    const navWrap = sel('[data-nav-wrap]');
    if (navWrap && navWrap.dataset.hb !== '1') {
      navWrap.dataset.hb = '1';
      navWrap.addEventListener('mouseleave', closePanel);
    }

    // --- 移动端抽屉 ---
    const drawerToggle = sel<HTMLButtonElement>('[data-drawer-toggle]');
    if (drawerToggle && drawerToggle.dataset.hb !== '1') {
      drawerToggle.dataset.hb = '1';
      drawerToggle.addEventListener('click', () => setDrawer(true));
    }
    const drawerClose = sel<HTMLButtonElement>('[data-drawer-close]');
    if (drawerClose && drawerClose.dataset.hb !== '1') {
      drawerClose.dataset.hb = '1';
      drawerClose.addEventListener('click', () => setDrawer(false));
    }
    const drawerScrim = sel('[data-drawer-scrim]');
    if (drawerScrim && drawerScrim.dataset.hb !== '1') {
      drawerScrim.dataset.hb = '1';
      drawerScrim.addEventListener('click', () => setDrawer(false));
    }

    // --- 搜索面板 ---
    const searchOpen = sel('[data-search-open]');
    if (searchOpen && searchOpen.dataset.hb !== '1') {
      searchOpen.dataset.hb = '1';
      searchOpen.addEventListener('click', openSearch);
    }
    const searchClose = sel('[data-search-close]');
    if (searchClose && searchClose.dataset.hb !== '1') {
      searchClose.dataset.hb = '1';
      searchClose.addEventListener('click', closeSearch);
    }
    const searchScrimEl = sel('[data-search-scrim]');
    if (searchScrimEl && searchScrimEl.dataset.hb !== '1') {
      searchScrimEl.dataset.hb = '1';
      searchScrimEl.addEventListener('click', closeSearch);
    }
    const searchInputEl = sel<HTMLInputElement>('[data-search-input]');
    if (searchInputEl && searchInputEl.dataset.hb !== '1') {
      searchInputEl.dataset.hb = '1';
      searchInputEl.addEventListener('input', (e) => {
        const value = (e.target as HTMLInputElement).value;
        window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => runSearch(value), 160);
      });
    }
    const searchDialogEl = sel('[data-search-dialog]');
    if (searchDialogEl && searchDialogEl.dataset.hb !== '1') {
      searchDialogEl.dataset.hb = '1';
      searchDialogEl.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') {
          e.preventDefault();
          const q = sel<HTMLInputElement>('[data-search-input]')?.value.trim();
          if (q) window.location.href = `/search?q=${encodeURIComponent(q)}`;
        }
      });
    }
  }

  // ---------- 全局快捷键（document 持久存在，只绑一次） ----------
  function initGlobalKeys() {
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const typing =
        target &&
        (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);

      const searchDialog = sel('[data-search-dialog]');
      const drawer = sel('[data-drawer]');

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
        return;
      }

      if (e.key === 'Escape') {
        if (searchDialog && !searchDialog.hidden) {
          closeSearch();
          return;
        }
        if (drawer?.dataset.open === 'true') {
          setDrawer(false);
          return;
        }
        closePanel();
        return;
      }

      if (e.key === '/' && !typing && !(searchDialog && !searchDialog.hidden)) {
        e.preventDefault();
        openSearch();
      }
    });
  }

  // 模块脚本在整站生命周期内只会执行一次；换页后由 astro:page-load 重新初始化。
  // 用 __portalHeader 标记避免脚本被重复注入时重复注册 document 级监听。
  const root = document as Document & { __portalHeader?: boolean };
  if (!root.__portalHeader) {
    root.__portalHeader = true;
    initGlobalKeys();
    document.addEventListener('astro:page-load', initHeader);
  }
  initHeader();
</script>
