---
import { eventTypeLabels } from '../../data/site';
import { u } from '../../lib/paths';

interface Props {
  title: string;
  startDate: Date;
  location: string;
  type: string;
  speakers?: string[];
  summary: string;
  href?: string;
}

const { title, startDate, location, type, speakers = [], summary, href } = Astro.props;

const iso = startDate.toISOString().slice(0, 10);
const month = String(startDate.getMonth() + 1).padStart(2, '0');
const day = String(startDate.getDate()).padStart(2, '0');
const isPast = startDate.getTime() < Date.now();
---

<article class="flex gap-5 border-b border-line py-5">
  <div class="shrink-0 text-center">
    <time datetime={iso} class="block">
      <span class="numeric block text-[1.375rem] leading-none font-medium text-ink">{day}</span>
      <span class="numeric mt-1 block text-[0.6875rem] tracking-widest text-ink-tertiary">{month} 月</span>
    </time>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <span class="tag">{eventTypeLabels[type] ?? type}</span>
      {isPast && <span class="tag tag-quiet">已结束</span>}
    </div>

    <h3 class="mt-2 text-[1.0625rem] leading-snug">
      {href ? <a href={u(href)} class="link-title">{title}</a> : <span class="text-ink">{title}</span>}
    </h3>

    <p class="mt-2 text-ui leading-relaxed text-ink-secondary">{summary}</p>

    <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-meta text-ink-tertiary">
      <div class="flex gap-1.5">
        <dt>地点</dt>
        <dd class="text-ink-secondary">{location}</dd>
      </div>
      {
        speakers.length > 0 && (
          <div class="flex gap-1.5">
            <dt>主讲</dt>
            <dd class="text-ink-secondary">{speakers.join('、')}</dd>
          </div>
        )
      }
    </dl>
  </div>
</article>
