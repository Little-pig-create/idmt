---
import NewsCard from './NewsCard.astro';

interface Props {
  items: any[];
  /** 仅第一页展示置顶条目 */
  showFeatured?: boolean;
}

const { items, showFeatured = false } = Astro.props;

const featured = showFeatured ? items.find((i) => i.data.featured) : undefined;
const rest = featured ? items.filter((i) => i.id !== featured.id) : items;
---

{
  featured && (
    <article class="border-b border-line pb-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="tag">精选</span>
        <time datetime={featured.data.date.toISOString().slice(0, 10)} class="numeric text-meta text-ink-tertiary">
          {featured.data.date.getFullYear()}.
          {String(featured.data.date.getMonth() + 1).padStart(2, '0')}.
          {String(featured.data.date.getDate()).padStart(2, '0')}
        </time>
      </div>
      <h2 class="mt-3 text-h2 leading-snug">
        <a href={`/news/${featured.id}`} class="link-title">{featured.data.title}</a>
      </h2>
      <p class="mt-3 max-w-2xl text-body leading-relaxed text-ink-secondary">{featured.data.summary}</p>
    </article>
  )
}

<div class="divide-y divide-line">
  {
    rest.map((item) => (
      <NewsCard
        title={item.data.title}
        date={item.data.date}
        summary={item.data.summary}
        href={`/news/${item.id}`}
        tags={item.data.tags.slice(0, 2)}
        featured={item.data.featured}
      />
    ))
  }
</div>
