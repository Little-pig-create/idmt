---
interface Props {
  title: string;
  date: Date;
  summary: string;
  href: string;
  tags?: string[];
  featured?: boolean;
}

const { title, date, summary, href, tags = [], featured = false } = Astro.props;

const iso = date.toISOString().slice(0, 10);
const display = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(
  date.getDate()
).padStart(2, '0')}`;
---

<article class="group py-5">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <time datetime={iso} class="numeric text-meta text-ink-tertiary">{display}</time>
    {featured && <span class="tag">精选</span>}
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>

  <h3 class="mt-2 text-[1.0625rem] leading-snug">
    <a href={href} class="link-title">{title}</a>
  </h3>

  <p class="mt-2 max-w-2xl text-ui leading-relaxed text-ink-secondary">{summary}</p>
</article>
