---
import { site } from '../../data/site';
import { nav } from '../../data/nav';
import { u } from '../../lib/paths';

const year = new Date().getFullYear();
---

<footer class="night border-t border-white/10">
  <div class="container-wide py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <a href={u("/")} class="inline-flex" aria-label={`${site.name} 首页`}>
          <img
            src={u('/images/brand/logo-idmt-reversed.webp')}
            alt={site.name}
            width="975"
            height="160"
            class="h-10 w-auto"
            loading="lazy"
          />
        </a>
        <p class="mt-6 max-w-sm text-[13.5px] leading-relaxed text-white/55">
          {site.tagline}。坚持面向未来、交叉融合、科教结合、开放创新，打通从基础研究到产业化的最后一公里。
        </p>
      </div>

      <div>
        <p class="font-mono text-[10px] tracking-[0.22em] text-white/35">EXPLORE</p>
        <ul class="mt-4 space-y-2.5">
          {nav.map((item) => (
            <li><a href={u(item.href)} class="text-[13.5px] text-white/65 transition-colors hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-mono text-[10px] tracking-[0.22em] text-white/35">PROGRAMMES</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href={u("/research")} class="text-[13.5px] text-white/65 hover:text-white">九大研究方向</a></li>
          <li><a href={u("/labs")} class="text-[13.5px] text-white/65 hover:text-white">十大专业实验室</a></li>
          <li><a href={u("/products")} class="text-[13.5px] text-white/65 hover:text-white">产品与方案</a></li>
          <li><a href={u("/join")} class="text-[13.5px] text-white/65 hover:text-white">招生与招聘</a></li>
          <li><a href={u("/news")} class="text-[13.5px] text-white/65 hover:text-white">新闻动态</a></li>
        </ul>
      </div>

      <div>
        <p class="font-mono text-[10px] tracking-[0.22em] text-white/35">CONTACT</p>
        <ul class="mt-4 space-y-3 text-[13.5px] text-white/65">
          <li class="leading-relaxed">{site.contactNote}</li>
        </ul>
        <a href={u("/contact")} class="mt-5 inline-flex h-9 items-center rounded-md border border-white/15 px-3.5 text-[12.5px] text-white/80 hover:border-white/35 hover:text-white">
          联系我们
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-6 text-[11.5px] text-white/35 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · {site.nameEn}</p>
      <p class="font-mono tracking-[0.12em]">RESEARCH / INNOVATION / IMPACT</p>
    </div>
  </div>
</footer>
