---
/**
 * 卡片配图：只有真实封面才占位
 *
 * 无封面时**整块不渲染**，而不是回落一张生成图形。
 * 站点实测 0 条目填了 `cover`，于是回落图形成了全站默认版面 ——
 * 一块 16:9 的装饰噪声，顶掉了本该由标题承担的视觉分量。
 * 学术机构站的新闻卡是日期 + 标题的排印，不是配图卡。
 *
 * 抽象图形（`AbstractFigure`）只在把它当**栏目标识**的地方显式使用，
 * 例如专题专栏卡；那种场合它编码的是「这是哪个专题」，不是冒充照片。
 *
 * 图框由本组件负责：调用方不再自己套 `.figure-frame`，
 * 否则无封面时会留下一个空的 16:9 盒子。
 */

interface Props {
  /** 真实图片 URL，例如 /images/foo.png；为空则整块不渲染 */
  cover?: string;
  /** 图片替代文本 */
  alt?: string;
  /** 图框比例类名 */
  aspect?: string;
  /** 首屏第一张建议 eager */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  cover,
  alt = '',
  aspect = 'aspect-[16/9]',
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

{
  cover && (
    <div class={`figure-frame ${aspect} ${className}`.trim()}>
      <img
        src={cover}
        alt={alt}
        loading={loading}
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>
  )
}
